<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!-- Configuracion de lanzamiento de Code Composer Studio (las versiones de
     Eclipse, hasta la 12) contra el simulador del MSP432P401R (fase T2).
     Instrucciones, limites y lo que NO esta probado: ide/msp432/README.md

     Es la de cubeide/simulador.launch con tres cambios: el GDB es el de la
     toolchain GNU que trae CCS, el arranque es `monitor reset halt` seguido de
     `maintenance flush register-cache` -GDB no relee los registros tras una
     orden `monitor`-, y el proyecto de ejemplo es de CCS (Debug/x.out). -->
<launchConfiguration type="org.eclipse.cdt.debug.gdbjtag.launchConfigurationType">
    <stringAttribute key="org.eclipse.cdt.launch.PROJECT_ATTR" value="TU_PROYECTO"/>
    <stringAttribute key="org.eclipse.cdt.launch.PROGRAM_NAME" value="Debug/TU_PROYECTO.out"/>
    <booleanAttribute key="org.eclipse.cdt.launch.PROJECT_BUILD_CONFIG_AUTO_ATTR" value="true"/>
    <stringAttribute key="org.eclipse.cdt.launch.DEBUGGER_START_MODE" value="run"/>

    <!-- El depurador: el arm-none-eabi-gdb de la toolchain GNU de CCS, con su
         RUTA COMPLETA (ccs/tools/compiler/gcc-arm-none-eabi_<version>/bin/).
         El gdb del PC no sirve: no lleva ARM (vease cubeide/README.md). -->
    <stringAttribute key="org.eclipse.cdt.dsf.gdb.DEBUG_NAME" value="arm-none-eabi-gdb"/>
    <booleanAttribute key="org.eclipse.cdt.dsf.gdb.NON_STOP" value="false"/>
    <booleanAttribute key="org.eclipse.cdt.dsf.gdb.UPDATE_THREADLIST_ON_SUSPEND" value="false"/>

    <!-- El objetivo remoto: el simulador, en el puerto de siempre. -->
    <stringAttribute key="org.eclipse.cdt.debug.gdbjtag.core.jtagDevice" value="Generic TCP/IP"/>
    <booleanAttribute key="org.eclipse.cdt.debug.gdbjtag.core.useRemoteTarget" value="true"/>
    <stringAttribute key="org.eclipse.cdt.debug.gdbjtag.core.ipAddress" value="localhost"/>
    <intAttribute key="org.eclipse.cdt.debug.gdbjtag.core.portNumber" value="3333"/>

    <!-- Arranque: el reset y el halt los hace el stub. Las casillas de
         Eclipse, desmarcadas, para no duplicar. -->
    <booleanAttribute key="org.eclipse.cdt.debug.gdbjtag.core.doReset" value="false"/>
    <booleanAttribute key="org.eclipse.cdt.debug.gdbjtag.core.doHalt" value="false"/>
    <intAttribute key="org.eclipse.cdt.debug.gdbjtag.core.delay" value="0"/>
    <stringAttribute key="org.eclipse.cdt.debug.gdbjtag.core.initCommands" value="monitor reset halt&#13;&#10;maintenance flush register-cache&#13;&#10;"/>

    <!-- La carga: el stub programa la Flash por el FLCTL, como la sonda de la
         placa (desprotege, borra el sector, programa en rafaga, protege). -->
    <booleanAttribute key="org.eclipse.cdt.debug.gdbjtag.core.loadImage" value="true"/>
    <booleanAttribute key="org.eclipse.cdt.debug.gdbjtag.core.useProjBinaryForImage" value="true"/>
    <booleanAttribute key="org.eclipse.cdt.debug.gdbjtag.core.useFileForImage" value="false"/>
    <stringAttribute key="org.eclipse.cdt.debug.gdbjtag.core.imageOffset" value=""/>
    <booleanAttribute key="org.eclipse.cdt.debug.gdbjtag.core.loadSymbols" value="true"/>
    <booleanAttribute key="org.eclipse.cdt.debug.gdbjtag.core.useProjBinaryForSymbols" value="true"/>
    <booleanAttribute key="org.eclipse.cdt.debug.gdbjtag.core.useFileForSymbols" value="false"/>
    <stringAttribute key="org.eclipse.cdt.debug.gdbjtag.core.symbolsOffset" value=""/>

    <!-- Tras cargar, otra vez al vector de reset, y a parar en main. -->
    <stringAttribute key="org.eclipse.cdt.debug.gdbjtag.core.runCommands" value="monitor reset halt&#13;&#10;maintenance flush register-cache&#13;&#10;"/>
    <booleanAttribute key="org.eclipse.cdt.debug.gdbjtag.core.setResumeAt" value="false"/>
    <booleanAttribute key="org.eclipse.cdt.debug.gdbjtag.core.setStopAt" value="true"/>
    <stringAttribute key="org.eclipse.cdt.debug.gdbjtag.core.stopAt" value="main"/>
    <booleanAttribute key="org.eclipse.cdt.debug.gdbjtag.core.setResume" value="true"/>
</launchConfiguration>
