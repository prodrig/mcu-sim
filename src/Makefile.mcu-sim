# =============================================================================
# Makefile — mcu-sim, modelo SystemC de microcontroladores STM32
#
# UN SOLO FICHERO PARA LAS TRES PLATAFORMAS. La plataforma se detecta sola y se
# puede forzar con una variable, que es lo único que hay que ajustar:
#
#   make                                   Linux o macOS, nativo
#   make PLATAFORMA=windows                Windows con MinGW-w64 (MSYS2/Git Bash)
#   make PLATAFORMA=windows CXX=x86_64-w64-mingw32-g++    cruzado desde Linux
#
# Requiere SystemC >= 2.3.3 (Accellera) y un compilador con C++17. El estándar
# tiene que COINCIDIR con el que se usó al compilar la biblioteca de SystemC; si
# no, el enlazado falla con un error sobre `sc_api_version_...`. El paquete de
# Ubuntu 24.04 usa C++17; si compilas SystemC tú mismo, ajusta CXXSTD.
#
#   make SYSTEMC_HOME=/opt/systemc CXXSTD=c++14
#   make                          # el simulador: monta una placa desde un XML
#   make test407                  # la suite del F407 (2055 comprobaciones)
#   make test446                  # la del F446, que es OTRO ejecutable
#   make test417                  # la del acelerador criptografico del F415/F417
#   make testserie                # la del puente UART (P-14), OTRO ejecutable
#   make testgui                  # la de la frontera con mcu-sim-gui (P-12), OTRO mas
#   make hash                     # los vectores de MD5/SHA-1, sin SystemC
#   make cryp                     # los de AES/DES/TDES, tampoco
#   make red                      # la capa de red, que NO necesita SystemC
#   make gui-proto                # el marco del protocolo con mcu-sim-gui, tampoco
#   make gui-saludo               # el saludo con mcu-sim-gui, contra el sim de verdad (Python)
#   make gui-marcha               # y con la simulacion en marcha: instantaneas y avisos (Python)
#   make gui-cnc                  # la fresadora CNC por fases: cadena, motores y drivers (Python)
#   make gui-ordenes              # y las ordenes: el ejemplo del enunciado y sus ecos (Python)
#   make gui-control              # y el control: pausa, paso, parar y el ritmo (Python)
#   make gui-argumentos           # que --argumentos dice lo mismo que --help y que argv (Python)
#   make gui-sin-mcu              # una placa sin MCU, y Fuente y Gnd con su limite (Python)
#   make gui-sistema              # conectores, y varias placas enchufadas: <sistema> (Python)
#   make serie                    # el destino y el formato de un PuenteSerie, tampoco
#   make rfc2217                  # el codec de Telnet y RFC 2217, tampoco
#   make interop                  # el puente UART contra pySerial y socat (Python)
#   make sflash-e4                # el cargador de la ROM del E4 por RFC 2217 (Python)
#   make bsl-p4                   # el BSL del P4 por RFC 2217, y BSL Scripter si esta (Python)
#   make eth-e4                   # el eco de lwIP del E4 por el puente Ethernet (Python)
#   make usb-e4                   # el CDC-ACM del E4 por el puente USB de clase (pySerial)
#   make e4-edumkii               # la BOOSTXL-EDUMKII sobre la LaunchPad del E4
#   make e4-retardo               # SysCtlDelay y la prebusqueda de la Flash del E4
#   make vectores                 # los vectores del CRYP/HASH y del CCM, sin SystemC ni compilar
#   make asan407                  # la suite del F407 con ASan + UBSan (Linux y macOS)
#   make asan446                  # y la del F446
#   make bench                    # el banco de medida del coste de simulación
#   make run IMG=firmware.bin     # carga una imagen en la Flash y simula
#   make plataforma               # qué ha detectado, sin compilar nada
#
# Los firmwares YA NO hay que compilarlos: los `.bin` estan versionados y un
# arbol recien clonado los trae. Estos objetivos siguen aqui para REGENERARLOS,
# que es otra cosa y no es gratis -lee «Los firmwares» mas abajo antes de usar
# ninguno-:
#
#   make test407fw                # regenera los firmwares de la suite y LUEGO test407
#   make test446fw                # lo mismo para la del F446
#   make test417fw                # y para la del F415/F417
#   make fw                       # solo los firmwares de las tres, sin simular
#   make cleanfw                  # BORRA los firmwares, que estan versionados
#
# Las tres variables que deciden todo, por si hay que tocarlas a mano:
#
#   PLATAFORMA    linux | macos | windows
#   SYSTEMC_HOME  dónde está SystemC (include/ y la biblioteca)
#   CXX           el compilador
#   CROSS         el PREFIJO del compilador cruzado de ARM para los firmwares
#                 (por omisión `arm-none-eabi-`); véase «Los firmwares» abajo
#   CXXSTD        el estándar de C++; TIENE que ser el mismo con el que se
#                 compiló la biblioteca de SystemC, o el enlazado falla con un
#                 `undefined reference to sc_api_version_...` (véase abajo)
#   B             DÓNDE se compila: los ejecutables y lo que dejan las pruebas
#                 de Python. Por omisión `build`, dentro de src/; puede ser
#                 una carpeta fuera del repositorio -una sincronizada con
#                 Dropbox o OneDrive no es buen sitio para miles de escrituras-:
#
#                   make B=/c/build/mcu-sim mcu-sim          (MSYS2 o Git Bash)
#                   make B=$$HOME/build/mcu-sim test407      (Linux, macOS)
#
#                 Sin espacios en la ruta: make no los soporta. Las pruebas
#                 se siguen lanzando desde src/. Y `make mcu-sim` copia a
#                 $(B), con su arbol, lo que hace falta para usarlo desde alli:
#                 las placas (placas/*.xml y sus dibujos .svg) y los firmwares
#                 (verif/fw/.../*.bin, con sus licencias). Solo eso: `make
#                 datos`.
#
# Y dos ganchos para añadir cosas SIN tocar este fichero, que es lo que hace
# falta cuando la biblioteca de SystemC de una máquina concreta se construyó con
# opciones distintas:
#
#   make EXTRA=-DSC_DISABLE_VIRTUAL_BIND        una macro más al compilar
#   make EXTRA_LD=-L/otra/ruta                  algo más al enlazar
#
# QUÉ HACER SI EL ENLAZADO FALLA CON `undefined reference to
# sc_core::sc_api_version_2_3_4_cxx201703L<...>`: no falta la biblioteca -si
# faltara, no habría UN símbolo sin resolver sino miles-. Es la comprobación
# deliberada que SystemC hace para que la aplicación y la biblioteca no se
# compilen con opciones distintas, y el nombre del símbolo lleva dentro la
# versión, el estándar de C++ y algunas macros. Para ver qué tiene la biblioteca
# de verdad:
#
#   nm -C $(SYSTEMC_HOME)/lib/libsystemc.a | grep api_version | head
#
# y comparar las dos cadenas. Si dice `cxx201402L`, compila con CXXSTD=c++14.
# =============================================================================

# --- 0. Dónde se compila -----------------------------------------------------
# Todo lo que se genera va a $(B). Tiene que estar antes que la plataforma,
# porque `BORRA` se fija allí con `:=`.
B ?= build

# --- 1. La plataforma --------------------------------------------------------
# En Windows, cmd.exe y los shells de MSYS2 y Git Bash heredan la variable de
# entorno OS=Windows_NT. Fuera de ahí se pregunta a uname. Y en los dos
# casos, lo que ponga el usuario en la línea de órdenes manda (`?=`).
#
# OS NO SIEMPRE ESTÁ: un shell de MSYS2 abierto con un entorno recortado -se
# vio el 2026-10-06, en una máquina de verdad- no la tiene, y el Makefile
# decidía «linux» y compilaba para Linux con el compilador de MinGW. Por eso
# uname también reconoce Windows: MINGW64_NT-10.0-..., MSYS_NT-..., CYGWIN_NT-...
ANFITRION := $(shell uname -s 2>/dev/null)
ifeq ($(OS),Windows_NT)
  PLATAFORMA ?= windows
else ifneq ($(filter MINGW% MSYS% CYGWIN%,$(ANFITRION)),)
  PLATAFORMA ?= windows
else ifeq ($(ANFITRION),Darwin)
  PLATAFORMA ?= macos
else
  PLATAFORMA ?= linux
endif

CXXSTD ?= c++17
CXX    ?= g++

# --- 2. Lo que cambia de una plataforma a otra -------------------------------
# Son cuatro cosas y nada más: dónde suele estar SystemC, cómo se llaman sus
# directorios de biblioteca, qué bibliotecas hay que enlazar y si el ejecutable
# lleva sufijo.

ifeq ($(PLATAFORMA),windows)
  # MinGW-w64 de 64 bits, 11.2 o posterior. Con MSYS2, SystemC suele acabar en
  # /mingw64; si se compila a mano, en C:/systemc o similar.
  SYSTEMC_HOME ?= /mingw64
  EXE          := .exe
  # Los sockets son Winsock, no Berkeley (véase common/red.h); y winmm, por
  # timeBeginPeriod, el reloj de 1 ms del freno de tiempo real (sim_main.cpp).
  LIBS_SO      := -lws2_32 -lwinmm
  # MinGW usa por omisión el printf de msvcrt, que NO entiende %llu ni %zu. El
  # modelo los usa 28 veces; sin esto, las cifras salen mal en silencio.
  DEF_SO       := -D__USE_MINGW_ANSI_STDIO=1
  # Un .exe que no necesita NINGUNA DLL de MinGW instalada: para repartirlo a
  # alumnos, esto no es un lujo.
  #
  # Y tiene que ser `-static`, no solo las dos de abajo, porque el GCC de MSYS2
  # esta construido con el modelo de hilos POSIX: `std::chrono`, `std::thread` y
  # SystemC entran por **winpthreads**, y eso mete una importacion de
  # `libwinpthread-1.dll` que `-static-libgcc -static-libstdc++` NO cubre.
  #
  # Lo que pasa si falta, medido en una maquina de verdad: el ejecutable
  # funciona desde el shell MINGW64 -ahi la DLL buena esta en el PATH- y desde
  # `cmd` da «no se encuentra el punto de entrada clock_gettime64 en la
  # biblioteca de vinculos dinamicos». Ojo al mensaje: NO dice que falte la DLL,
  # dice que la DLL que ha encontrado no exporta ese simbolo. Es decir, hay
  # OTRA `libwinpthread-1.dll` mas antigua delante en el PATH -de otro MinGW,
  # de Qt, de un IDE- y gana ella. Un fallo que depende del orden del PATH de
  # cada maquina es exactamente el que no se puede depurar por correo.
  LDEXTRA      := -static -static-libgcc -static-libstdc++
  LIBDIRS      := $(SYSTEMC_HOME)/lib $(SYSTEMC_HOME)/lib-mingw64 \
                  $(SYSTEMC_HOME)/lib64
  RPATH        :=
  BORRA        := rm -rf $(B)
  # El g++ de MinGW deja sus ficheros intermedios donde digan TMP o TEMP, y si
  # no hay ninguna de las dos, en C:\Windows, donde no puede escribir:
  #   «Cannot create temporary file in C:\windows\: Permission denied»
  # Es el mismo entorno recortado de arriba. Sin ellas, el /tmp de MSYS2, que
  # siempre existe; el shell se lo traduce al compilador a una ruta de Windows.
  ifeq ($(strip $(TMP)$(TEMP)),)
    export TMP  := /tmp
    export TEMP := /tmp
    $(info aviso: sin TMP ni TEMP en el entorno; el compilador usara /tmp)
  endif
else ifeq ($(PLATAFORMA),macos)
  # Homebrew en Apple Silicon vive en /opt/homebrew; en Intel, en /usr/local.
  SYSTEMC_HOME ?= $(shell test -d /opt/homebrew/include/sysc && \
                          echo /opt/homebrew || echo /usr/local)
  EXE          :=
  LIBS_SO      := -lpthread
  DEF_SO       :=
  LDEXTRA      :=
  LIBDIRS      := $(SYSTEMC_HOME)/lib $(SYSTEMC_HOME)/lib-macosx64 \
                  $(SYSTEMC_HOME)/lib-macosarm64
  RPATH        := $(foreach d,$(LIBDIRS),-Wl,-rpath,$(d))
  BORRA        := rm -rf $(B)
else
  SYSTEMC_HOME ?= /usr
  EXE          :=
  LIBS_SO      := -lpthread
  DEF_SO       :=
  LDEXTRA      :=
  LIBDIRS      := $(SYSTEMC_HOME)/lib $(SYSTEMC_HOME)/lib-linux64 \
                  $(SYSTEMC_HOME)/lib64 $(SYSTEMC_HOME)/lib/x86_64-linux-gnu
  RPATH        := $(foreach d,$(LIBDIRS),-Wl,-rpath,$(d))
  BORRA        := rm -rf $(B)
endif

# --- 3. Lo que NO cambia -----------------------------------------------------
AVISOS   := -Wall -Wextra -Wno-unused-parameter
# Procesos dinamicos (sc_spawn), que pin_mux.h usa para los procesos del mux.
# `<systemc>` solo los expone si esta macro esta definida ANTES de incluirlo, asi
# que tiene que venir de aqui. Es la via oficial; la alternativa seria incluir
# una cabecera interna de SystemC, y esa es la que cambia entre versiones.
DEFS     := -DSC_INCLUDE_DYNAMIC_PROCESSES
# LA VERSION que `mcu-sim` dice de si mismo (T_HOLA y `--argumentos`;
# `top/sim_main.cpp`). Sin decirla, «desarrollo». Se fija con
# `make ... VERSION_MCU_SIM=0.2.0`, y la integracion continua la saca SOLA de
# la etiqueta que se construye -`v0.2.0` da `0.2.0`-: GitHub pone
# GITHUB_REF_TYPE y GITHUB_REF_NAME en el entorno de cada paso, asi que vale
# para todos los `make` del trabajo, tambien los de las suites.
ifeq ($(GITHUB_REF_TYPE),tag)
  VERSION_MCU_SIM ?= $(patsubst v%,%,$(GITHUB_REF_NAME))
endif
ifneq ($(VERSION_MCU_SIM),)
  DEFS += -DVERSION_MCU_SIM=\"$(VERSION_MCU_SIM)\"
endif
# `-isystem` y no `-I` para SystemC: le dice al compilador que esas cabeceras no
# son nuestras y deja de avisar de lo que pasa dentro de ellas. Con GCC 16 sobre
# SystemC 2.3.4 salen decenas de avisos de -Woverloaded-virtual en los sockets de
# TLM que no podemos arreglar y que solo tapan los nuestros.
#
# CON UNA EXCEPCION, y muerde: si SystemC viene del sistema (SYSTEMC_HOME=/usr,
# que es el caso del paquete de Ubuntu), marcar /usr/include como -isystem lo
# SACA de su sitio en la cadena estandar de cabeceras y deja de encontrarse
# <stdlib.h>. Ahi hay que usar -I normal.
ifeq ($(SYSTEMC_HOME),/usr)
  INC_SYSTEMC := -I$(SYSTEMC_HOME)/include
else
  INC_SYSTEMC := -isystem $(SYSTEMC_HOME)/include
endif
CXXFLAGS += -std=$(CXXSTD) $(AVISOS) $(DEFS) $(DEF_SO) -g -O2 \
            $(INC_SYSTEMC) -I. $(EXTRA)
LDFLAGS  += $(foreach d,$(LIBDIRS),-L$(d)) $(RPATH) $(LDEXTRA)
LDLIBS   += -lsystemc $(LIBS_SO) $(EXTRA_LD)

HDRS := $(wildcard common/*.h pins/*.h parts/*.h bus/*.h mem/*.h rcc/*.h core/*.h \
                   periph/*.h soc/*.h verif/*.h top/*.h \
                   periph/msp432p4/*.h soc/msp432p4/*.h soc/msp432p4/*.inc \
                   periph/msp432e4/*.h soc/msp432e4/*.h soc/msp432e4/*.inc \
                   soc/stm32f3/*.h soc/stm32f3/*.inc)

TEST407 := $(B)/test407$(EXE)
MCUSIM  := $(B)/mcu-sim$(EXE)
TEST446 := $(B)/test446$(EXE)
TEST417 := $(B)/test417$(EXE)
TESTSERIE := $(B)/testserie$(EXE)
TESTGUI   := $(B)/testgui$(EXE)
TESTP4    := $(B)/testp4$(EXE)
TESTE4    := $(B)/teste4$(EXE)
TESTF3    := $(B)/testf3$(EXE)
HASHV   := $(B)/prueba_hash$(EXE)
CRYPV   := $(B)/prueba_cryp$(EXE)
BENCH  := $(B)/bench$(EXE)
RED    := $(B)/prueba_red$(EXE)
SERIEP := $(B)/prueba_serie$(EXE)
RFC2217P := $(B)/prueba_rfc2217$(EXE)
GUIPROTO := $(B)/prueba_gui_proto$(EXE)
ASAN407 := $(B)/asan407$(EXE)
ASAN446 := $(B)/asan446$(EXE)
ASAN417 := $(B)/asan417$(EXE)
ASANP4  := $(B)/asanp4$(EXE)
ASANE4  := $(B)/asane4$(EXE)
ASANSERIE := $(B)/asanserie$(EXE)

.PHONY: all testp4 testp4-build asanp4 fwp4 testp4fw teste4 teste4-build asane4 fwe4 teste4fw testf3 testf3-build fwf3 testf3fw f3-discovery f3-vcp f3-demo f3-stm32flash test407 test446 test417 test407fw test446fw test417fw fw fw407 fw446 fw417 cleanfw test446-build test417-build testserie testserie-build testgui testgui-build asan407 asan446 asan417 asanserie smoke bench mcu-sim p4-edumkii p4-rom-ti openocd cmsis-dap xds110 red serie rfc2217 gui-proto gui-saludo gui-marcha gui-cnc gui-ordenes gui-control gui-argumentos gui-sin-mcu gui-sistema interop sflash-e4 bsl-p4 eth-e4 usb-e4 usb-f3 e4-edumkii e4-retardo run clean plataforma vectores hash cryp datos

all: $(MCUSIM)

# Qué ha decidido el Makefile, por si algo no cuadra. Es la primera orden que
# hay que ejecutar cuando la compilación falla en una máquina nueva.
plataforma:
	@echo "PLATAFORMA   = $(PLATAFORMA)"
	@echo "CXX          = $(CXX)"
	@echo "CXXSTD       = $(CXXSTD)"
	@echo "SYSTEMC_HOME = $(SYSTEMC_HOME)"
	@echo "EXE          = '$(EXE)'"
	@echo "LDLIBS       = $(LDLIBS)"
	@echo "LIBDIRS      = $(LIBDIRS)"
	@echo "B            = $(B)"
	@echo "ANFITRION    = $(ANFITRION)   (uname -s; OS = '$(OS)')"
	@echo "TMP          = '$(TMP)'   TEMP = '$(TEMP)'"

$(TEST407): top/sc_main.cpp $(HDRS)
	@mkdir -p $(B)
	$(CXX) $(CXXFLAGS) -o $@ top/sc_main.cpp $(LDFLAGS) $(LDLIBS)

# Banco de MEDIDA del coste de simulación (no verifica: mide)
#   make bench && ./build/bench [imagen.bin] [ms_simulados] [reset]
#   (con B=otra/carpeta, los ejecutables están allí: otra/carpeta/bench)
$(BENCH): top/bench_main.cpp $(HDRS)
	@mkdir -p $(B)
	$(CXX) $(CXXFLAGS) -o $@ top/bench_main.cpp $(LDFLAGS) $(LDLIBS)

bench: $(BENCH)

# El modelo con la PLACA EN UN FICHERO (paso 3 de parts/)
#   make mcu-sim && ./build/mcu-sim placa.xml [firmware.bin] [ms]
$(MCUSIM): top/sim_main.cpp $(HDRS)
	@mkdir -p $(B)
	$(CXX) $(CXXFLAGS) -o $@ top/sim_main.cpp $(LDFLAGS) $(LDLIBS)

mcu-sim: $(MCUSIM) datos

# LO QUE HACE FALTA PARA USAR EL EJECUTABLE DESDE $(B), y no solo desde src/:
# las placas con sus dibujos y los firmwares, con el MISMO ARBOL que en src/
# -placas/nucleo_y_shield.xml, verif/fw/blinky446/blinky446.bin- porque las
# placas los nombran asi, relativos a donde se lanza. Con las licencias de lo
# que va compilado dentro de los firmwares (CMSIS, CoreMark): copiarlos es
# redistribuirlos. Solo se copia lo que ha cambiado. Con el B de siempre
# acaba en src/build/, que git no ve. Es lo mismo que llevan los paquetes del
# CI.
#   make datos B=/c/build/mcu-sim
DATOS := $(wildcard placas/*.xml placas/*.svg) \
         $(wildcard verif/fw/*.bin verif/fw/*/*.bin) \
         $(wildcard verif/fw/*/LICENSE*)
DATOS_B := $(addprefix $(B)/,$(DATOS))
datos: $(DATOS_B)
$(DATOS_B): $(B)/%: %
	@mkdir -p $(dir $@)
	cp -p $< $@

# La SUITE DEL F446, que es un banco APARTE y no unas pruebas mas dentro de
# `sc_main.cpp`. El motivo esta escrito en la cabecera de su fichero y merece
# saberse: construir un segundo chip dentro del banco del F407 MUEVE el
# invariante del F407, porque un chip no es inerte. Dos chips en la misma
# simulacion son una placa de dos chips.
#   make test446
$(TEST446): top/sc_main_f446.cpp $(HDRS)
	@mkdir -p $(B)
	$(CXX) $(CXXFLAGS) -o $@ top/sc_main_f446.cpp $(LDFLAGS) $(LDLIBS)

# Construir sin ejecutar, por si se quiere compilar y lanzar a mano.
test446-build: $(TEST446)

test446: $(TEST446)
	$(TEST446)

# EL BANCO DEL MSP432P401R (fases T0 y T1 de doc/analisis_msp432.md). Otro
# ejecutable, por la razon de siempre: un chip mas dentro de otro banco mueve
# su invariante. Lleva tambien las pruebas propias de T0 -nombres de pin por
# chip, catalogo comun, ELF/TI-TXT/HEX, integracion del nucleo-, que no gastan
# tiempo simulado y no podian ir en test407 sin cambiar su cifra.
#   make testp4
$(TESTP4): top/sc_main_p4.cpp $(HDRS)
	@mkdir -p $(B)
	$(CXX) $(CXXFLAGS) -o $@ top/sc_main_p4.cpp $(LDFLAGS) $(LDLIBS)

testp4-build: $(TESTP4)

testp4: $(TESTP4)
	$(TESTP4)

# EL BANCO DEL MSP432E401Y (fase T6 de doc/analisis_msp432.md): el segundo
# MSP432, otro ejecutable por lo mismo que el del P4.
#   make teste4
$(TESTE4): top/sc_main_e4.cpp $(HDRS)
	@mkdir -p $(B)
	$(CXX) $(CXXFLAGS) -o $@ top/sc_main_e4.cpp $(LDFLAGS) $(LDLIBS)

teste4-build: $(TESTE4)

teste4: $(TESTE4)
	$(TESTE4)

# EL BANCO DEL STM32F303VC (fases S0-S2 de doc/analisis_stm32f303.md): otra
# familia de ST, otro ejecutable, por lo mismo que los demas.
#   make testf3
$(TESTF3): top/sc_main_f3.cpp $(HDRS)
	@mkdir -p $(B)
	$(CXX) $(CXXFLAGS) -o $@ top/sc_main_f3.cpp $(LDFLAGS) $(LDLIBS)

testf3-build: $(TESTF3)

testf3: $(TESTF3)
	$(TESTF3)

# --- La capa de red, que es la única parte no portable -----------------------
# No necesita SystemC, así que se compila y se ejecuta en cualquier sitio, y se
# puede CRUZAR desde Linux para comprobar que la rama de Winsock enlaza:
#
#   make red PLATAFORMA=windows CXX=x86_64-w64-mingw32-g++
#
# Es la prueba que hay que pasar antes de dar por buena una plataforma nueva.
$(RED): verif/prueba_red.cpp common/red.h
	@mkdir -p $(B)
	$(CXX) -std=$(CXXSTD) $(AVISOS) $(DEF_SO) -O2 -I. -o $@ \
	       verif/prueba_red.cpp $(LDEXTRA) $(LIBS_SO)

# EL BANCO DEL ACELERADOR CRIPTOGRAFICO del F415/F417 (fase 2 de su plan). Es
# el TERCER ejecutable por la misma razon que el del F446 es el segundo:
# construir piezas nuevas dentro del banco del F407 mueve su invariante.
# Prueba el PROTOCOLO -DATATYPE, NBLW, DCAL, las fases del HMAC, BUSY, las dos
# interrupciones y el contexto-; la aritmetica se prueba aparte con `make hash`.
#   make test417
$(TEST417): top/sc_main_f417.cpp $(HDRS)
	@mkdir -p $(B)
	$(CXX) $(CXXFLAGS) -o $@ top/sc_main_f417.cpp $(LDFLAGS) $(LDLIBS)

test417-build: $(TEST417)

test417: $(TEST417)
	$(TEST417)

# EL BANCO DEL PUENTE UART (P-14, doc/analisis_puente_serie.md §10). CUARTO
# ejecutable, por la razon de siempre: sus piezas dentro del banco del F407
# moverian su invariante. Tiene el suyo en verif/invariantes.txt, y crece con
# cada fase: en D1 prueba el motor UART suelto; en D2, la pieza con un F407.
#   make testserie
$(TESTSERIE): top/sc_main_serie.cpp $(HDRS)
	@mkdir -p $(B)
	$(CXX) $(CXXFLAGS) -o $@ top/sc_main_serie.cpp $(LDFLAGS) $(LDLIBS)

testserie-build: $(TESTSERIE)

testserie: $(TESTSERIE)
	$(TESTSERIE)

# EL BANCO DE LA FRONTERA CON mcu-sim-gui (P-12, fase 1 de su plan de dos
# procesos). QUINTO ejecutable, por la razon de siempre: el muestreador y el
# aplicador hacen cosas en el tiempo, y probarlas dentro del banco del F407
# moveria su invariante. Alli se queda construida y SIN ACTIVAR, que es como
# esta en `sim` sin `--gui`, y su invariante es la prueba de que no cuesta nada.
# Este tiene el suyo en verif/invariantes.txt.
#   make testgui
$(TESTGUI): top/sc_main_gui.cpp $(HDRS)
	@mkdir -p $(B)
	$(CXX) $(CXXFLAGS) -o $@ top/sc_main_gui.cpp $(LDFLAGS) $(LDLIBS)

testgui-build: $(TESTGUI)

testgui: $(TESTGUI)
	$(TESTGUI)

# Los VECTORES de MD5 y SHA-1 contra el nucleo aritmetico. NO necesita SystemC:
# `periph/hash_algo.h` es aritmetica pura, y los 23 casos con su procedencia
# estan en `verif/vectores/hash.vec` desde la fase 0.
#   make hash            # los rapidos
#   make hash V=--lentos # tambien el del millon de letras
$(HASHV): verif/prueba_hash.cpp periph/hash_algo.h
	@mkdir -p $(B)
	$(CXX) -std=$(CXXSTD) $(AVISOS) -O2 -I. -o $@ verif/prueba_hash.cpp

hash: $(HASHV)
	$(HASHV) $(V)

# Y los de AES, DES y TDES contra el suyo. Pasa los 16 casos de `cryp.vec` en
# las DOS direcciones: cifrar la entrada tiene que dar la salida, y descifrar la
# salida tiene que devolver la entrada.
#   make cryp
$(CRYPV): verif/prueba_cryp.cpp periph/cryp_algo.h
	@mkdir -p $(B)
	$(CXX) -std=$(CXXSTD) $(AVISOS) -O2 -I. -o $@ verif/prueba_cryp.cpp

cryp: $(CRYPV)
	$(CRYPV) $(V)

red: $(RED) macros-win
	$(RED)

# EL DESTINO DE UN PUENTE SERIE (fase D0 de doc/analisis_puente_serie.md §10):
# el parseo de `host=` y de `--serie ID=DESTINO`, y los choques de puertos. Es
# aritmetica de cadenas, asi que NO necesita SystemC ni toca las tres cifras de
# verif/invariantes.txt: va con `red` y `hash` en el trabajo rapido del CI.
#   make serie
$(SERIEP): verif/prueba_serie.cpp common/serie_destino.h common/formato_uart.h
	@mkdir -p $(B)
	$(CXX) -std=$(CXXSTD) $(AVISOS) -O2 -I. -o $@ verif/prueba_serie.cpp

serie: $(SERIEP)
	$(SERIEP)

# EL CODEC DE TELNET Y RFC 2217 (fase D4 de P-14): contra el texto de las RFC y
# contra una sesion de verdad de pySerial (verif/vectores/rfc2217_pyserial.vec).
# Tampoco necesita SystemC. Enlaza con la capa de red solo por su modo
# `--servidor PUERTO`, que no es una prueba sino un banco de interoperabilidad
# para clientes de verdad; por eso lleva las mismas opciones que `red`.
#   make rfc2217
$(RFC2217P): verif/prueba_rfc2217.cpp common/telnet2217.h common/red.h
	@mkdir -p $(B)
	$(CXX) -std=$(CXXSTD) $(AVISOS) $(DEF_SO) -O2 -I. -o $@ \
	       verif/prueba_rfc2217.cpp $(LDEXTRA) $(LIBS_SO)

rfc2217: $(RFC2217P)
	$(RFC2217P)

# EL TRANSPORTE CON mcu-sim-gui (P-12, fase 2 de su plan de dos procesos): el
# marco del protocolo -`common/proto_io.h`- y `conecta`/`escucha` con host de
# `common/red.h`, con dos hilos y un socket de verdad. Sin SystemC, como `red`:
# no toca ninguna cifra de verif/invariantes.txt. Con GUI_REPO=ruta compara
# ademas las copias compartidas con las de mcu-sim-gui, byte a byte (R-6); sin
# ella las busca al lado de este repositorio, y si no estan lo dice y sigue.
#   make gui-proto
#   make gui-proto GUI_REPO=../../mcu-sim-gui
$(GUIPROTO): verif/prueba_gui_proto.cpp common/proto_io.h common/protocolo.h common/red.h
	@mkdir -p $(B)
	$(CXX) -std=$(CXXSTD) $(AVISOS) $(DEF_SO) -O2 -I. -o $@ \
	       verif/prueba_gui_proto.cpp $(LDEXTRA) $(LIBS_SO)

gui-proto: $(GUIPROTO)
	$(GUIPROTO) $(if $(GUI_REPO),--gui-repo $(GUI_REPO))

# LA INTEROPERABILIDAD DEL PUENTE UART (fase D6 de doc/analisis_puente_serie.md
# §10): el `mcu-sim` de verdad, con `placas/vcp_rfc2217.xml` y `vcp_demo`,
# contra el cliente `rfc2217://` y `socket://` de pySerial y contra un pty de
# socat si esta. Necesita Python 3 y pySerial; no toca ningun invariante.
#
#   make interop
PYTHON ?= python3
interop: $(MCUSIM)
	$(PYTHON) verif/serie/interop.py --sim $(MCUSIM)

# EL CARGADOR SERIE DE LA ROM DEL MSP432E4 (T6): el `mcu-sim` de verdad, con
# placas/msp_exp432e401y.xml y SIN firmware (la Flash en blanco arranca el
# cargador de la ROM R1), y sflash_e4.py por RFC 2217 programando e4_t3.bin,
# arrancandolo y esperando su saludo. Python 3 y pySerial; sin invariante.
#
#   make sflash-e4
sflash-e4: $(MCUSIM)
	$(PYTHON) verif/serie/sflash_e4.py --prueba --sim $(MCUSIM)

# EL BSL DEL MSP432P4 (T5, D4): el `mcu-sim` de verdad con
# placas/msp_exp432p401r.xml y SIN firmware (la Flash en blanco entra en el
# BSL B1), y bsl_p4.py por RFC 2217 programando el ejemplo de eco de TI,
# arrancandolo y comprobando el eco. Con BSL_SCRIPTER=<bsl-scripter-linux-64>
# pasa ademas el guion de ejemplo de BSL Scripter de TI por un pty de socat.
#
#   make bsl-p4
bsl-p4: $(MCUSIM)
	$(PYTHON) verif/serie/bsl_p4.py --prueba --sim $(MCUSIM)

# EL ETHERNET DEL MSP432E4 (T7): el `mcu-sim` de verdad con
# placas/msp_exp432e401y.xml y e4_eth (lwIP 2.2.1, eco TCP y UDP en el 7), el
# puente en qemu:PUERTO con --tiempo-real, y eco_e4.py haciendo de ordenador
# en 192.168.127.1 con su propia pila: ARP, ping, eco UDP y eco TCP, con las
# sumas de comprobacion que pone el EMAC. Deja la captura en build/eth_e4.pcap.
# Y otra vez con e4_bootp, que llama a ROM_UpdateEMAC: eco_e4.py contesta al
# BOOTP, sirve e4_eth.bin por TFTP, y hace lo mismo con lo que se ha grabado.
#
#   make eth-e4
eth-e4: $(MCUSIM)
	$(PYTHON) verif/eth/eco_e4.py --prueba --sim $(MCUSIM) --pcap $(B)/eth_e4.pcap
	$(PYTHON) verif/eth/eco_e4.py --prueba --bootp --sim $(MCUSIM)

# EL USB DEL MSP432E4 (T7): el `mcu-sim` de verdad con placas/msp_exp432e401y.xml
# y e4_usb (un CDC-ACM sobre usb.c de DriverLib), y el puente de clase (U2 de
# doc/analisis_puente_usb.md) en --usb rfc2217:PUERTO y luego en tcp:PUERTO:
# el puente enumera el dispositivo como un PC y cdc_e4.py es el terminal. Con
# pySerial, que los baudios, la paridad, la parada y DTR que se ponen en el
# terminal llegan al firmware como SET_LINE_CODING y SET_CONTROL_LINE_STATE;
# con un socket, el eco y 4 KB de ida y vuelta.
#
#   make usb-e4
usb-e4: $(MCUSIM)
	$(PYTHON) verif/usb/cdc_e4.py --prueba --sim $(MCUSIM)

# EL USB DE USUARIO DE LA STM32F3DISCOVERY (S6 del F303): lo mismo que usb-e4,
# con f3_usb (TinyUSB sobre el FSDEV) y `--usb`: pySerial por RFC 2217 y un
# socket por TCP contra el CDC-ACM del compuesto, a tiempo real
usb-f3: $(MCUSIM)
	$(PYTHON) verif/usb/cdc_e4.py --prueba --f3 --sim $(MCUSIM)

# EL SALUDO CON mcu-sim-gui (P-12, fase 3 de su plan): el `mcu-sim` de verdad,
# con placas/discovery_min.xml y blinky, contra una ventana hecha en Python con
# su PROPIA implementacion del marco -no comparte proto_io.h, a proposito-.
# Que espera sin CPU y sin tiempo simulado hasta T_ARRANCA, que con el simula
# lo mismo que sin --gui, --valida --gui y los errores. Solo Python 3, sin
# modulos; con psutil mide tambien la CPU fuera de Linux.
gui-saludo: $(MCUSIM)
	$(PYTHON) verif/gui/saludo.py --sim $(MCUSIM)

# CON LA SIMULACION EN MARCHA (P-12, fase 4): la misma ventana en Python, y el
# blinky de placas/discovery_min.xml parpadeando en las instantaneas con el
# periodo que programa el firmware. Tambien que la secuencia se repite al
# picosegundo, los avisos de placa, lo que se habla en marcha y que mcu-sim
# sigue si la ventana se va. Unos segundos: usa --tiempo-real en dos grupos.
gui-marcha: $(MCUSIM)
	$(PYTHON) verif/gui/marcha.py --sim $(MCUSIM)

# LA FRESADORA CNC, por fases (doc/analisis_cnc.md §11): la cadena mecanica y
# el efecto desplaza (F0), los paso a paso y sus drivers (F1a), la continua de
# potencia (F1b) y el BLDC con su controlador (F1c). La misma ventana en
# Python; unos segundos.
gui-cnc: $(MCUSIM)
	$(PYTHON) verif/gui/cnc.py --sim $(MCUSIM)

# LAS ORDENES (P-12, fase 5): la misma ventana en Python mandando ordenes al
# pulsador B1 de placas/discovery_min.xml. El ejemplo de doc/protocolo.md §5
# antes de arrancar -cuatro ecos en exactamente 1,00 / 1,50 / 4,00 / 4,22 s,
# reproducibles-, la validacion (pieza, mando, rango con aviso, delta 0,
# malformadas) y las relativas en marcha, con --tiempo-real.
gui-ordenes: $(MCUSIM)
	$(PYTHON) verif/gui/ordenes.py --sim $(MCUSIM)

# EL CONTROL (P-12, fase 6): pausar -el tiempo no avanza, el modelo sigue
# contestando a T_PING y no gasta CPU-, seguir, parar; a demanda, con pasos
# exactos y lo mismo que de un tiron; la ventana de tiempo de T_ARRANCA y la
# que no tiene fin. Unos segundos: el primer grupo va a tiempo real.
gui-control: $(MCUSIM)
	$(PYTHON) verif/gui/control.py --sim $(MCUSIM)

# LA LISTA DE OPCIONES (P-12, fase 7): `mcu-sim --argumentos` la vuelca en XML
# para que mcu-sim-gui construya su dialogo de lanzamiento. Esto vigila que no
# se separe del bucle que lee argv: lo mismo que --help, y cada opcion la
# acepta `sim` de verdad. Segundos.
gui-argumentos: $(MCUSIM)
	$(PYTHON) verif/gui/argumentos.py --sim $(MCUSIM)

# UNA PLACA SIN MCU: placas/fuente_y_masa.xml, que no declara chip ninguno,
# contra la misma ventana en Python. Las dos piezas que la hacen util -Fuente
# y Gnd- con su limite de corriente: la corriente que se ve, la sobrecorriente
# como alarma y su T_AVISO, y la vuelta al soltar el corto. Tambien lo que sin
# MCU se rechaza -firmware, --gdb, un nodo PD12- y que --mcu manda sobre un
# <mcu>. Segundos; no toca ningun invariante.
gui-sin-mcu: $(MCUSIM)
	$(PYTHON) verif/gui/sin_mcu.py --sim $(MCUSIM)

# VARIAS PLACAS ENCHUFADAS (P-15): la pieza Conector, y un <sistema> que junta
# placas -de su fichero o escritas dentro- con <acopla> y <hilo>. La Nucleo
# con un shield sin MCU (placas/nucleo_y_shield.xml), el espejo, dos chips en
# dos placas, T_PLACA en las versiones 1 y 2 del protocolo y los errores. Y una
# pila PC/104 (placas/pila_pc104.xml), y lo que T_PLACA cuenta de cada placa.
# Segundos; no toca ningun invariante.
gui-sistema: $(MCUSIM)
	$(PYTHON) verif/gui/sistema.py --sim $(MCUSIM)

# LA BOOSTXL-EDUMKII SOBRE LA MSP-EXP432P401R (T3 del MSP432): el sistema de
# placas/msp_exp432p401r_edumkii.xml con verif/fw/msp432p4/edumkii_demo, 400
# ms, mirando lo que dice por el backchannel -el joystick y el acelerometro
# por el ADC14, la luz del OPT3001 y la temperatura del TMP006 por I2C- y lo
# que ha recibido la pantalla por SPI. Lo que no comprueba testp4, que monta
# las piezas a mano: que las dos placas se acoplan por J1-J4 pin a pin.
#   make p4-edumkii
p4-edumkii: $(MCUSIM)
	@$(MCUSIM) placas/msp_exp432p401r_edumkii.xml --ms=400 --serie L/BCL=memoria \
	    > $(B)/p4-edumkii.log 2>&1 || { cat $(B)/p4-edumkii.log; exit 1; }
	@grep -q "joy=2048,2048 acc_z=2867 lux=300.00 t=25.00 s1=0 s2=0" $(B)/p4-edumkii.log \
	    && grep -q "10 ordenes, 20480 pixeles" $(B)/p4-edumkii.log \
	    && ! grep -q "Warning" $(B)/p4-edumkii.log \
	    && echo "  [OK  ] p4-edumkii: el backchannel, el ADC14, los dos sensores I2C y la pantalla" \
	    || { echo "  [FALLO] p4-edumkii: vease $(B)/p4-edumkii.log"; exit 1; }

# LA BOOSTXL-EDUMKII SOBRE LA MSP-EXP432E401Y: el sistema de
# placas/msp_exp432e401y_edumkii.xml (la EDUMKII en la BoosterPack 1, con su
# J5 pasado a la luz de la pantalla por el <jumper> del sistema) con
# verif/fw/msp432e4/e4_edumkii, 400 ms: la misma linea que la de la P401R
# por el backchannel -que llega por JP4/JP5 y J101-, la pantalla con su luz
# y lo que ha recibido por la SSI2.
#   make e4-edumkii
e4-edumkii: $(MCUSIM)
	@$(MCUSIM) placas/msp_exp432e401y_edumkii.xml --ms=400 --serie L/BCL=memoria \
	    > $(B)/e4-edumkii.log 2>&1 || { cat $(B)/e4-edumkii.log; exit 1; }
	@grep -q "joy=2048,2048 acc_z=2867 lux=300.00 t=25.00 s1=0 s2=0" $(B)/e4-edumkii.log \
	    && grep -q "10 ordenes, 20480 pixeles; luz 3.4 mA" $(B)/e4-edumkii.log \
	    && grep -q "dibujo E: boostxl_edumkii.svg (.*J5 PWM-LCD)" $(B)/e4-edumkii.log \
	    && ! grep -q "Warning" $(B)/e4-edumkii.log \
	    && echo "  [OK  ] e4-edumkii: el backchannel por JP4/JP5, el ADC, los dos sensores I2C y la pantalla con luz" \
	    || { echo "  [FALLO] e4-edumkii: vease $(B)/e4-edumkii.log"; exit 1; }

# LA STM32F3DISCOVERY (S1 del F303, doc/analisis_stm32f303.md): el mcu-sim de
# verdad con placas/stm32f3discovery.xml y GPIO_IOToggle de STM32CubeF3, sin
# modificar. A los 1000 ms la rosa esta a medio dar la vuelta: LD6 (PE15) y
# LD8 (PE14) apagados y los otros seis encendidos -el ejemplo enciende un LED
# cada 101 ms, de PE15 a PE8, y luego los apaga en el mismo orden-; el reloj,
# 72 MHz por el HSE desde el MCO del ST-LINK (onda="no"); y sin un aviso.
#   make f3-discovery
f3-discovery: $(MCUSIM)
	@$(MCUSIM) placas/stm32f3discovery.xml verif/fw/stm32f3/gpio_iotoggle/GPIO_IOToggle.bin \
	    --ms=1000 > $(B)/f3-discovery.log 2>&1 || { cat $(B)/f3-discovery.log; exit 1; }
	@grep -q "placa 'stm32f3discovery': 1 MCU(s), 26 componentes, 160 nodos, 0 avisos" $(B)/f3-discovery.log \
	    && grep -q "dibujo: stm32f3discovery.svg (.*JP3 1-2, U3 LSM303AGR, U5 I3G4250D)" $(B)/f3-discovery.log \
	    && grep -q "LED LD6 en PE15: apagado" $(B)/f3-discovery.log \
	    && grep -q "LED LD8 en PE14: apagado" $(B)/f3-discovery.log \
	    && test "$$(grep -c 'LED LD[0-9]* en PE[0-9]*: encendido' $(B)/f3-discovery.log)" = 6 \
	    && ! grep -q "Warning" $(B)/f3-discovery.log \
	    && echo "  [OK  ] f3-discovery: GPIO_IOToggle de ST en la STM32F3DISCOVERY, la rosa a 72 MHz por el HSE" \
	    || { echo "  [FALLO] f3-discovery: vease $(B)/f3-discovery.log"; exit 1; }

# EL PUERTO COM VIRTUAL DE LA STM32F3DISCOVERY (S3 del F303): el VCP de
# placas/stm32f3discovery.xml, la USART1 en PC4/PC5, con verif/fw/stm32f3/f3_vcp
# a 115200 8N1 y 72 MHz, en memoria (--serie VCP=memoria): el saludo y una
# linea cada 100 ms, sin un error de trama ni un aviso. Y el sistema de dos
# Discovery (placas/dos_f3discovery.xml, con UART_TwoBoards_ComIT de ST):
# --valida dice que el VCP de B se corre al 3356, y en marcha, con los dos
# VCP en memoria, A espera su B1 con LD4 parpadeando y nadie enciende LD5 (el
# intercambio en si, con la pulsacion, es F22-F24 de testf3).
#   make f3-vcp
f3-vcp: $(MCUSIM)
	@$(MCUSIM) placas/stm32f3discovery.xml verif/fw/stm32f3/f3_vcp/f3_vcp.bin \
	    --ms=350 --serie VCP=memoria > $(B)/f3-vcp.log 2>&1 || { cat $(B)/f3-vcp.log; exit 1; }
	@grep -q "\[VCP\] f3_vcp: la USART1 por PC4/PC5, 115200 8N1, SYSCLK 72 MHz" $(B)/f3-vcp.log \
	    && grep -q "\[VCP\] tic 3" $(B)/f3-vcp.log \
	    && grep -q "serie VCP: 79 bytes del MCU (0 con error de trama, 0 de paridad)" $(B)/f3-vcp.log \
	    && ! grep -q "Warning" $(B)/f3-vcp.log \
	    && echo "  [OK  ] f3-vcp: el VCP de la STM32F3DISCOVERY, la USART1 por PC4/PC5" \
	    || { echo "  [FALLO] f3-vcp: vease $(B)/f3-vcp.log"; exit 1; }
	@$(MCUSIM) placas/dos_f3discovery.xml --valida > $(B)/f3-dos.log 2>&1 || { cat $(B)/f3-dos.log; exit 1; }
	@$(MCUSIM) placas/dos_f3discovery.xml --ms=650 --serie A/VCP=memoria --serie B/VCP=memoria \
	    >> $(B)/f3-dos.log 2>&1 || { cat $(B)/f3-dos.log; exit 1; }
	@grep -q "B/VCP: el puerto 3355 es tambien el de A/VCP en su fichero; escucha en el 3356" $(B)/f3-dos.log \
	    && grep -q "en total: 2 MCU(s), 55 componentes, 312 nodos, 0 avisos" $(B)/f3-dos.log \
	    && grep -q "LED A/LD4 en A/u0.PE8: encendido" $(B)/f3-dos.log \
	    && ! grep -q "LD5 en [AB]/u0.PE10: encendido" $(B)/f3-dos.log \
	    && ! grep -q "Warning" $(B)/f3-dos.log \
	    && echo "  [OK  ] f3-vcp: dos STM32F3DISCOVERY en un sistema, cada VCP en su puerto" \
	    || { echo "  [FALLO] f3-vcp: vease $(B)/f3-dos.log"; exit 1; }

# LA DEMOSTRACION DE ST PARA LA STM32F3DISCOVERY (S4 del F303): es SLA0044 y
# no se versiona, asi que se compila aqui desde una copia de STM32CubeF3 con su
# middleware USB y la prueba F58 de testf3 (TESTF3_SOLO=demo) la corre: la
# rosa, el giroscopo con el LED del lado que baja y el acelerometro. Sin
# STM32CUBEF3 se OMITE y lo dice. No va en el CI.
#   make -f Makefile.mcu-sim f3-demo STM32CUBEF3=/ruta/a/STM32CubeF3
STM32CUBEF3 ?=
f3-demo: $(TESTF3)
	@if [ -z "$(STM32CUBEF3)" ]; then \
	   echo "  [OMITE] f3-demo: hace falta STM32CUBEF3=/ruta/a/STM32CubeF3 (con Middlewares/ST/STM32_USB_Device_Library)"; \
	 else \
	   $(MAKE) --no-print-directory -C verif/fw/stm32f3/ejemplos_s4 demo STM32CUBEF3="$(STM32CUBEF3)" >$(B)/f3-demo-fw.log 2>&1 \
	     || { cat $(B)/f3-demo-fw.log; exit 1; }; \
	   TESTF3_SOLO=demo $(TESTF3) > $(B)/f3-demo.log 2>&1; \
	   sed -n '/--- F58/,/TOTAL/p' $(B)/f3-demo.log | grep "OK  \]\|FALLO\]"; \
	   grep -q "comprobaciones OK, 0 fallos" $(B)/f3-demo.log \
	     && echo "  [OK  ] f3-demo: la demostracion de ST en la STM32F3DISCOVERY" \
	     || { echo "  [FALLO] f3-demo: vease $(B)/f3-demo.log"; exit 1; }; \
	 fi

# EL CARGADOR DE SISTEMA DEL F303 CON stm32flash (S7 del F303): el sistema
# placas/stm32f3discovery_boot0.xml -la Discovery con BOOT0 a VDD y un FT232RL
# en la USART1- a tiempo real, su U1 por RFC 2217, verif/pty_rfc2217.py que lo
# convierte en un pty a 115200 8E1, y stm32flash 0.7, sin modificar, que borra,
# (con -m 8n1: un pty de Linux no guarda la paridad, y stm32flash comprueba lo
# que pone; la paridad de verdad la pone el puente RFC 2217)
# escribe f3_vcp.bin, lo verifica y lo arranca (GO): el VCP de la placa, en
# memoria, tiene que dar su saludo. Sin stm32flash o sin pySerial se OMITE y lo
# dice. No va en el CI (necesita un pty y tiempo real).
#   make -f Makefile.mcu-sim f3-stm32flash
PUERTO_STM32FLASH ?= 47361
f3-stm32flash: $(MCUSIM)
	@if ! command -v stm32flash >/dev/null 2>&1; then \
	   echo "  [OMITE] f3-stm32flash: no hay stm32flash (apt install stm32flash)"; \
	 elif ! python3 -c "import serial" >/dev/null 2>&1; then \
	   echo "  [OMITE] f3-stm32flash: hace falta pySerial (python3 -m pip install pyserial)"; \
	 else \
	   rm -f $(B)/f3tty; \
	   $(MCUSIM) placas/stm32f3discovery_boot0.xml --ms=6000 --tiempo-real \
	       --serie F/U1=rfc2217:$(PUERTO_STM32FLASH) --serie D/VCP=memoria \
	       > $(B)/f3-stm32flash-sim.log 2>&1 & sim=$$!; \
	   python3 verif/pty_rfc2217.py $(PUERTO_STM32FLASH) $(B)/f3tty 115200 8E1 \
	       > $(B)/f3-stm32flash-pty.log 2>&1 & pty=$$!; \
	   i=0; while [ ! -e $(B)/f3tty ] && [ $$i -lt 100 ]; do sleep 0.1; i=$$((i+1)); done; \
	   stm32flash -b 115200 -m 8n1 -w verif/fw/stm32f3/f3_vcp/f3_vcp.bin -v -g 0x0 $(B)/f3tty \
	       > $(B)/f3-stm32flash.log 2>&1; r=$$?; \
	   sleep 1; kill $$pty 2>/dev/null; wait $$sim; \
	   cat $(B)/f3-stm32flash-sim.log >> $(B)/f3-stm32flash.log; \
	   test $$r = 0 \
	     && grep -q "Device ID *: 0x0422" $(B)/f3-stm32flash.log \
	     && grep -q "Version *: 0x31" $(B)/f3-stm32flash.log \
	     && grep -q "Wrote and verified address 0x08000414 (100.00%) Done" $(B)/f3-stm32flash.log \
	     && grep -q "\[D/VCP\] f3_vcp: la USART1 por PC4/PC5" $(B)/f3-stm32flash.log \
	     && echo "  [OK  ] f3-stm32flash: stm32flash borra, escribe, verifica y arranca f3_vcp por el cargador AN3155" \
	     || { echo "  [FALLO] f3-stm32flash: vease $(B)/f3-stm32flash.log"; exit 1; }; \
	 fi

# LA PREBUSQUEDA DE LA FLASH DEL E4 A 120 MHz (FWS = 5):
# verif/fw/msp432e4/e4_retardo mide con el TIMER2 los ciclos de una vuelta
# del bucle de SysCtlDelay alineado en una linea de 256 bits, cruzando una
# linea, desde la SRAM, el de la ROM y el de DriverLib. Los seis tienen que
# dar lo mismo, 4 ciclos (3 + 1 del salto tomado del nucleo: P-17 m): con
# una sola linea de prebusqueda, los que cruzan daban 14.
#   make e4-retardo
e4-retardo: $(MCUSIM)
	@$(MCUSIM) placas/msp_exp432e401y.xml verif/fw/msp432e4/e4_retardo/e4_retardo.out \
	    --ms=200 --serie BCL=memoria > $(B)/e4-retardo.log 2>&1 \
	    || { cat $(B)/e4-retardo.log; exit 1; }
	@grep -q "e4_retardo: f=120000000 FWS=5" $(B)/e4-retardo.log \
	    && test "$$(grep -c 'ciclos/vuelta' $(B)/e4-retardo.log)" = 6 \
	    && awk '/ciclos\/vuelta/ { v = $$(NF-1); if (v < 3.95 || v > 4.05) mal = 1 } \
	            END { exit mal }' $(B)/e4-retardo.log \
	    && echo "  [OK  ] e4-retardo: SysCtlDelay a 120 MHz, 4 ciclos por vuelta en la Flash (crucen linea o no), la SRAM y la ROM" \
	    || { grep "ciclos/vuelta" $(B)/e4-retardo.log; \
	         echo "  [FALLO] e4-retardo: vease $(B)/e4-retardo.log"; exit 1; }

# T5: OpenOCD DE VERDAD contra el modelo, por los pines, con la sonda
# remote_bitbang (--openocd): `program ... verify reset` en el MSP432P401R
# con target/ti/msp432.cfg y en el F407 con target/stm32f4x.cfg, sin
# tocarlos, y GDB por OpenOCD con los hilos de FreeRTOS. Y desde S2 del F303
# (O5), la STM32F3DISCOVERY con target/stm32f3x.cfg y `load` por su servidor
# de GDB; `make cmsis-dap` hace lo mismo por CMSIS-DAP (C6). Hace falta un
# OpenOCD de git (ci/construye_openocd.sh): con la 0.12.0 de las
# distribuciones la prueba se OMITE y lo dice, salvo con OPENOCD_OBLIGATORIO=1.
#   make -f Makefile.mcu-sim openocd OPENOCD=/ruta/a/bin/openocd
OPENOCD ?= openocd
openocd: $(MCUSIM)
	OPENOCD="$(OPENOCD)" python3 verif/openocd/programa.py --sim $(MCUSIM)

# X2 de doc/analisis_xds110.md: la sonda CMSIS-DAP por TCP (--cmsis-dap). El
# protocolo a mano, sin OpenOCD; y con el `cmsis-dap tcp` de OpenOCD (de git
# posterior al 2025-09-01): program ... verify reset en el P401R y el E401Y
# por su XDS110 y en el F407 por sus pines, lo que tarda frente a
# remote_bitbang, y GDB con FreeRTOS. Sin ese OpenOCD, la parte de OpenOCD
# se OMITE y lo dice, salvo con OPENOCD_OBLIGATORIO=1.
#   make -f Makefile.mcu-sim cmsis-dap OPENOCD=/ruta/a/bin/openocd
cmsis-dap: $(MCUSIM)
	OPENOCD="$(OPENOCD)" python3 verif/openocd/cmsis_dap.py --sim $(MCUSIM)

# X1 de doc/analisis_xds110.md: la sonda XDS110 como pieza de las dos
# LaunchPad. El 3V3 de su LDO por J101 (sin el puente el chip no arranca), la
# traza SWO de p4_swo y e4_swo en memoria, en crudo y por TCP, y, con
# OpenOCD, que la sonda va por el puente de TMS_SWDIO.
#   make -f Makefile.mcu-sim xds110
xds110: $(MCUSIM)
	OPENOCD="$(OPENOCD)" python3 verif/openocd/xds110.py --sim $(MCUSIM)

# T4: la ROM sustituta (R1) frente a la de TI (R2), que no se versiona: los
# mismos ejemplos con las dos, y lo que tarda cada uno hasta encender P1.0.
#   make -f Makefile.mcu-sim p4-rom-ti ROM_TI=.../msp432_driverlib_rom_image.out
# Tambien vale un volcado binario de los 32 KB de 0x0200_0000.
p4-rom-ti: $(TESTP4)
	@test -n "$(ROM_TI)" || { echo "p4-rom-ti: falta ROM_TI=<la ROM de TI: el .out de CCS o un volcado>"; exit 2; }
	TESTP4_SOLO=rom_ti P4_ROM_TI="$(ROM_TI)" $(TESTP4)
	$(MAKE) --no-print-directory -C verif/fw/msp432p4/rom_r1 contrasta ROM_TI="$(abspath $(ROM_TI))"

# EL CAMPO DE MINAS DEL PREPROCESADOR DE WINDOWS. Prueba de COMPILACION, no de
# ejecucion: define a mano las macros que Windows trae -R_OK, min, max, ERROR,
# VERSION...- e incluye las dos cabeceras que este proyecto comparte con
# mcu-sim-gui. Si alguna vuelve a usar un nombre que alli es macro, falla AQUI,
# en Linux, y no tres semanas despues en la maquina de un alumno.
#
# Va colgado de `red` a proposito: es la otra comprobacion que no necesita
# SystemC y que hay que pasar antes de dar por buena una plataforma.
.PHONY: macros-win
macros-win:
	@$(CXX) -std=$(CXXSTD) $(AVISOS) -fsyntax-only -I. \
	        verif/prueba_macros_win.cpp \
	 && echo "  [OK  ] las cabeceras compartidas sobreviven a las macros de Windows"

# Los VECTORES DE PRUEBA de los aceleradores criptográficos del F415/F417 y
# del CCM del MSP432E4. No compila nada y no necesita SystemC: vuelve a
# calcular con dos implementaciones independientes -OpenSSL, pycryptodome,
# cryptography, crccheck, hashlib- los 90 casos de `verif/vectores/*.vec` y
# los compara con lo que dice el fichero. Es la red de
# seguridad de un periférico que, mal modelado, NO falla: cifra.
#   make vectores            # los rápidos
#   make vectores V=--lentos # también el del millón de letras
vectores:
	python3 verif/vectores/comprueba_vectores.py $(V)

# La misma suite, con los sanitizers de direcciones y de comportamiento
# indefinido. Detecta lo que la suite no puede ver por sí sola: accesos fuera de
# sitio, usos después de liberar y memoria que no se devuelve.
#
#   make asan407         # compila y corre; debe salir 0 fugas y 0 avisos
#
# Va a -O1 porque con -O2 los sanitizers pierden marcos y los informes dejan de
# decir dónde. Y NO hace falta poner ASAN_OPTIONS a mano: el ejecutable trae su
# propia configuración (véase common/asan_opciones.h), sin la cual SystemC se
# rompe antes de la primera comprobación.
#
# Solo en Linux y macOS: MinGW no trae AddressSanitizer.
ASANFLAGS := -std=$(CXXSTD) $(AVISOS) $(DEFS) $(DEF_SO) -g -O1 \
             -fsanitize=address,undefined -fno-omit-frame-pointer \
             $(INC_SYSTEMC) -I. $(EXTRA)

$(ASAN407): top/sc_main.cpp $(HDRS)
	@mkdir -p $(B)
	$(CXX) $(ASANFLAGS) -o $@ top/sc_main.cpp $(LDFLAGS) $(LDLIBS)

ifeq ($(PLATAFORMA),windows)
asan407:
	@echo "MinGW no trae AddressSanitizer: 'make asan407' solo va en Linux y macOS."
else
asan407: $(ASAN407)
	$(ASAN407)
endif

# Lo mismo para la suite del F446. Va aparte porque es otro ejecutable, por la
# misma razón que `test446`: dos chips en una simulación son una placa de dos
# chips [top/sc_main_f446.cpp].
$(ASAN446): top/sc_main_f446.cpp $(HDRS)
	@mkdir -p $(B)
	$(CXX) $(ASANFLAGS) -o $@ top/sc_main_f446.cpp $(LDFLAGS) $(LDLIBS)

ifeq ($(PLATAFORMA),windows)
asan446:
	@echo "MinGW no trae AddressSanitizer: 'make asan446' solo va en Linux y macOS."
else
asan446: $(ASAN446)
	$(ASAN446)
endif

# Y para el del MSP432P401R.
$(ASANP4): top/sc_main_p4.cpp $(HDRS)
	@mkdir -p $(B)
	$(CXX) $(ASANFLAGS) -o $@ top/sc_main_p4.cpp $(LDFLAGS) $(LDLIBS)

ifeq ($(PLATAFORMA),windows)
asanp4:
	@echo "MinGW no trae AddressSanitizer: 'make asanp4' solo va en Linux y macOS."
else
asanp4: $(ASANP4)
	$(ASANP4)
endif

# Y para el del MSP432E401Y.
$(ASANE4): top/sc_main_e4.cpp $(HDRS)
	@mkdir -p $(B)
	$(CXX) $(ASANFLAGS) -o $@ top/sc_main_e4.cpp $(LDFLAGS) $(LDLIBS)

ifeq ($(PLATAFORMA),windows)
asane4:
	@echo "MinGW no trae AddressSanitizer: 'make asane4' solo va en Linux y macOS."
else
asane4: $(ASANE4)
	$(ASANE4)
endif

# Y para el del acelerador criptográfico, que es el tercero.
$(ASAN417): top/sc_main_f417.cpp $(HDRS)
	@mkdir -p $(B)
	$(CXX) $(ASANFLAGS) -o $@ top/sc_main_f417.cpp $(LDFLAGS) $(LDLIBS)

ifeq ($(PLATAFORMA),windows)
asan417:
	@echo "MinGW no trae AddressSanitizer: 'make asan417' solo va en Linux y macOS."
else
asan417: $(ASAN417)
	$(ASAN417)
endif

# Y para el del puente UART, que es el cuarto.
$(ASANSERIE): top/sc_main_serie.cpp $(HDRS)
	@mkdir -p $(B)
	$(CXX) $(ASANFLAGS) -o $@ top/sc_main_serie.cpp $(LDFLAGS) $(LDLIBS)

ifeq ($(PLATAFORMA),windows)
asanserie:
	@echo "MinGW no trae AddressSanitizer: 'make asanserie' solo va en Linux y macOS."
else
asanserie: $(ASANSERIE)
	$(ASANSERIE)
endif

# Suite de verificación (autocomprobable: código de salida 0/1)
#
# Ojo: hay que ejecutarla DESDE `src/`, que es lo que hace `make`. Las imágenes
# de firmware se cargan por rutas relativas (`verif/fw/...`) y desde otro
# directorio fallan diecisiete comprobaciones que no tienen nada que ver con lo
# que se estuviera mirando.
test407: $(TEST407)
	$(TEST407)

# Alias histórico de la fase F0
smoke: test407

run: $(TEST407)
	$(TEST407) $(IMG)

# =============================================================================
# LOS FIRMWARES DE LAS SUITES
#
# Veinte grupos de las tres suites cargan un `.bin` de verdad en la Flash del
# modelo y lo ejecutan con el Cortex-M4. Esos diecinueve `.bin` **SI se
# versionan**, con una excepcion explicita en el .gitignore, y son 37 KB.
#
# POR QUE, que es lo unico interesante de todo esto. Antes no se versionaban,
# «porque son producto de compilacion», y habia que construirlos en cada
# maquina. Consecuencia: cada maquina ejecutaba UN PROGRAMA DISTINTO. El
# `arm-none-eabi-gcc` 13.2 de Debian y el 13.3.1 de STM32CubeIDE producen
# CoreMark de 14528 y 14856 bytes; un binario distinto ejecuta un numero
# distinto de instrucciones; y como `t17_coremark()` sondea el final cada 2 ms,
# la diferencia salia cuantizada a 2 ms y parecia un problema de plataforma.
# Se tardo dos diagnosticos en verlo. Vease T-22 en doc/todo.md.
#
# Asi que un arbol recien clonado YA TIENE los firmwares y `make test407` basta.
# Cual es la imagen buena lo dice `verif/fw/huellas.txt`, y el primer grupo de
# cada suite (T00 / A0) lo comprueba antes de simular nada.
#
# Estos objetivos sirven para REGENERARLOS, que es una decision y no un
# tramite: con otra cadena cruzada saldran otros binarios, el tiempo simulado
# se movera, y habra que actualizar el manifiesto y los invariantes de
# doc/compilacion.md. Los objetivos avisan y no lo impiden; `git checkout -- .`
# deshace.
#
# ---------------------------------------------------------------------------
# COMO SE LE DICE DONDE ESTA EL COMPILADOR DE ARM
#
# Con UNA variable, `CROSS`, que es el PREFIJO del nombre de las herramientas.
# El Makefile de cada firmware la respeta desde siempre (`CROSS ?= arm-none-eabi-`)
# y de ahi salen `$(CROSS)gcc`, `$(CROSS)objcopy` y `$(CROSS)objdump`.
#
#   1. Si `arm-none-eabi-gcc` esta en el PATH, no hay que hacer NADA.
#
#   2. Si no lo esta, se da la ruta completa hasta el guion final:
#
#        make test407fw CROSS=/opt/gcc-arm/bin/arm-none-eabi-
#        make test407fw CROSS='C:/ST/STM32CubeIDE_1.17.0/STM32CubeIDE/plugins/\
#                              com.st.stm32cube.ide.mcu.externaltools.gnu-tools-\
#                              for-stm32.../tools/bin/arm-none-eabi-'
#
#      Ojo al guion del final: es un PREFIJO, no un ejecutable. Sin el, el
#      Makefile intentara ejecutar algo llamado `.../bingcc`.
#
#   3. Y si se va a usar siempre la misma, se exporta una vez por sesion:
#
#        export CROSS=/opt/gcc-arm/bin/arm-none-eabi-
#
# De donde sacarlo en cada sistema:
#
#   Debian/Ubuntu   apt install gcc-arm-none-eabi
#   MSYS2           pacman -S mingw-w64-x86_64-arm-none-eabi-toolchain
#   macOS           brew install --cask gcc-arm-embedded
#
# En MSYS2, el GRUPO `-toolchain` y no el paquete `-gcc` a secas: estos
# Makefiles necesitan ademas `objcopy`, que viene en binutils. Y si ese nombre
# no existe -MSYS2 los renombra de vez en cuando-, se averigua en vez de
# adivinarse:  pacman -Ss arm-none-eabi
#
# EL ATAJO, y probablemente el mejor: quien usa este simulador tiene
# STM32CubeIDE, y CubeIDE trae su propio arm-none-eabi-gcc con su objcopy. No
# hay que instalar nada, solo encontrarlo:
#
#   ls -d /c/ST/STM32CubeIDE_*/STM32CubeIDE/plugins/*gnu-tools-for-stm32*/tools/bin
#   export CROSS=<esa ruta>/arm-none-eabi-
#   ${CROSS}gcc --version
#
# No hace falta que sea la misma version que se uso aqui: el firmware es C
# bare-metal corriente y no depende de nada exotico.
# =============================================================================

# =============================================================================
# EL `Makefile` DE ESTA CARPETA NO SE VERSIONA, Y ESO TIENE UNA TRAMPA
#
# Lo versionado es ESTE fichero, `Makefile.mcu-sim`. El `Makefile` a secas esta
# en el .gitignore y es local de cada maquina. El motivo es de fontaneria: las
# herramientas con las que se edita este arbol en remoto se niegan a escribir un
# fichero llamado `Makefile`, por ser un nombre protegido.
#
# LA TRAMPA: durante mucho tiempo la receta fue `cp Makefile.mcu-sim Makefile`,
# y una copia **envejece en silencio**. Un `git pull` que traiga objetivos
# nuevos aqui no los pone ahi, y `make` contesta «No rule to make target», que
# es un mensaje que no se parece en nada a su causa: el objetivo existe, lo que
# pasa es que tu `Makefile` es de antes.
#
# LA SALIDA, que no envejece: que el `Makefile` no sea una copia sino un
# ENLACE de una linea.
#
#     make -f Makefile.mcu-sim enlaza
#
# deja un `Makefile` que dice `include Makefile.mcu-sim` y ya nunca hay que
# volver a acordarse. Y mientras tanto, `make -f Makefile.mcu-sim <objetivo>`
# funciona siempre, con copia o sin ella.
# =============================================================================

# Si este fichero NO aparece en la lista de makefiles leidos, es que se esta
# ejecutando una COPIA suya llamada `Makefile`. Funciona, pero caduca.
ifeq ($(filter Makefile.mcu-sim,$(MAKEFILE_LIST)),)
  $(warning )
  $(warning   ojo: estas usando una COPIA de Makefile.mcu-sim, que envejece sin avisar.)
  $(warning   Cambiala por un enlace de una linea y olvidate:  make -f Makefile.mcu-sim enlaza)
  $(warning )
endif

.PHONY: enlaza
enlaza:
	@printf 'include Makefile.mcu-sim\n' > Makefile
	@echo "  Makefile ahora incluye Makefile.mcu-sim: ya no puede quedarse atras."

# El makefile que se esta leyendo: `Makefile` si se entro por el enlace de una
# linea, o `Makefile.mcu-sim` si se llamo con -f. Las llamadas recursivas de
# abajo TIENEN que pasarlo, porque si no el sub-make coge el `Makefile` por
# omision, que puede ser una copia vieja -o no existir- y contesta «No rule to
# make target 'test417'» hablando de un objetivo que si existe aqui.
ESTE_MAKEFILE := $(firstword $(MAKEFILE_LIST))

CROSS ?= arm-none-eabi-
export CROSS

# Que firmware usa cada suite. La lista sale de los `.bin` que cada sc_main
# carga, y es la parte que habia que recordar de memoria.
#
# `verif/fw` es la raiz y construye `test_isa.bin` (T15/T16); los demas son un
# directorio por demo.
FW407 := verif/fw verif/fw/coremark verif/fw/blinky verif/fw/dma_demo \
         verif/fw/uart_demo verif/fw/tim_demo verif/fw/exti_demo \
         verif/fw/spi_demo verif/fw/i2c_demo verif/fw/adc_demo \
         verif/fw/dac_demo verif/fw/sdio_demo verif/fw/crc_rng_demo \
         verif/fw/can_demo verif/fw/debug_demo verif/fw/lowpower_demo
FW446 := verif/fw/blinky446 verif/fw/clk446_demo
FW417 := verif/fw/crypto_demo
FWSERIE := verif/fw/vcp_demo
# Los del MSP432P401R: con la cabecera de TI y el mismo compilador.
FWP4 := verif/fw/msp432p4/p4_demo verif/fw/msp432p4/coremark verif/fw/msp432p4/p4_t3 \
        verif/fw/msp432p4/p4_t3b verif/fw/msp432p4/edumkii_demo verif/fw/msp432p4/driverlib_t3 \
        verif/fw/msp432p4/rom_r1 verif/fw/msp432p4/sdk_ejemplos verif/fw/msp432p4/freertos_blinky \
        verif/fw/msp432p4/bsl_b1 verif/fw/msp432p4/p4_bsl
# Los del MSP432E401Y (T6): con la cabecera y DriverLib de TI para el E4.
FWE4 := verif/fw/msp432e4/e4_demo verif/fw/msp432e4/coremark verif/fw/msp432e4/e4_nv \
        verif/fw/msp432e4/e4_t3 verif/fw/msp432e4/e4_rom verif/fw/msp432e4/rom_r1 \
        verif/fw/msp432e4/e4_t7 verif/fw/msp432e4/e4_eth verif/fw/msp432e4/e4_bootp \
        verif/fw/msp432e4/e4_usb verif/fw/msp432e4/e4_edumkii
# Los del STM32F303VC (S1 y S2 de doc/analisis_stm32f303.md): con el CMSIS de
# ST (verif/fw/stm32f3/sdk) y, los de STM32CubeF3, con su HAL, sin modificar.
FWF3 := verif/fw/stm32f3/f3_demo verif/fw/stm32f3/coremark verif/fw/stm32f3/gpio_iotoggle \
        verif/fw/stm32f3/gpio_exti verif/fw/stm32f3/flash_eraseprogram \
        verif/fw/stm32f3/f3_vcp verif/fw/stm32f3/ejemplos_s3 \
        verif/fw/stm32f3/f3_mems verif/fw/stm32f3/ejemplos_s4 verif/fw/stm32f3/f3_analog \
        verif/fw/stm32f3/f3_usb verif/fw/stm32f3/f3_can
# Los de las placas de ejemplo que no usa ninguna suite de C++: el de
# placas/barra8_en_nucleo.xml y el de placas/nucleo_f446re_barra8ac_azul.xml,
# que vigila `make gui-sistema`; los de la pantalla TFT, el de
# placas/nucleo_f446re_tft.xml y su prueba, que vigila `make gui-marcha`; y los
# del servo, el de placas/nucleo_f446re_servo.xml, que vigila `make
# gui-ordenes`, y su prueba, que vigila `make gui-marcha`; y el del servo con
# el FTDI, el de placas/nucleo_f446re_encoder_tft_servo.xml, y el de los dos
# motores, el de placas/nucleo_f446re_encoder_lcd_servo_2xmcc.xml, que vigila
# `make gui-ordenes`; y el PID de posicion del eje servo de continua de la
# CNC, el de placas/nucleo_f446re_ibt2_jgb37.xml, que vigila `make gui-cnc`;
# el control numerico de la fresadora, el de placas/cnc_3020.xml, y la prueba
# del contexto FP de las excepciones anidadas que destapo, que vigila tambien
# `make gui-cnc`
FWPLACAS := verif/fw/barra8_demo verif/fw/barra8_morpho verif/fw/tft_demo verif/fw/tft_prueba \
            verif/fw/servo_demo verif/fw/servo_prueba verif/fw/encoder_tft_servo \
            verif/fw/encoder_lcd_servo_2xmcc verif/fw/cnc_pid verif/fw/cnc \
            verif/fw/fp_anidado

# Todos los que hay, para `cleanfw`. Se calculan buscando Makefiles en vez de
# escribir otra lista: asi un firmware nuevo se borra sin tocar esto.
FW_TODOS := $(sort $(patsubst %/Makefile,%,$(wildcard verif/fw/Makefile verif/fw/*/Makefile \
                                                         verif/fw/msp432p4/*/Makefile \
                                                         verif/fw/msp432e4/*/Makefile \
                                                         verif/fw/stm32f3/*/Makefile)))

# Un aviso util en vez de veinte errores de «command not found». No aborta: hay
# quien tiene el compilador en un sitio raro y sabe lo que hace.
define COMPRUEBA_CROSS
	@command -v $(CROSS)gcc >/dev/null 2>&1 || { \
	  echo ""; \
	  echo "  ojo: no encuentro '$(CROSS)gcc' en el PATH."; \
	  echo "  Dale la ruta con CROSS, que es un PREFIJO y acaba en guion:"; \
	  echo "      make $@ CROSS=/ruta/a/bin/arm-none-eabi-"; \
	  echo "  (Debian: apt install gcc-arm-none-eabi | MSYS2: pacman -S mingw-w64-x86_64-arm-none-eabi-toolchain)"; \
	  echo ""; }
endef

# Los .bin estan versionados, asi que regenerarlos ENSUCIA el arbol de trabajo.
# No se prohibe -hay que poder rehacerlos- pero se dice, antes y no despues.
define AVISA_VERSIONADOS
	@echo ""
	@echo "  ojo: los .bin de verif/fw estan VERSIONADOS; esto los sobrescribe."
	@echo "  Con otra cadena cruzada saldran otros binarios, el tiempo simulado"
	@echo "  se movera y el primer grupo de la suite (T00/A0) fallara, porque"
	@echo "  contrasta lo que hay contra verif/fw/huellas.txt."
	@echo "      git status verif/fw      -> que ha cambiado"
	@echo "      git checkout -- verif/fw -> deshacerlo"
	@echo "  Si el cambio es querido, actualiza tambien huellas.txt y los"
	@echo "  invariantes de doc/compilacion.md. Vease T-22."
	@echo ""
endef

.PHONY: fw fw407 fw446 fw417 fwserie fwplacas cleanfw test407fw test446fw test417fw testseriefw

fw407:
	$(AVISA_VERSIONADOS)
	$(COMPRUEBA_CROSS)
	@for d in $(FW407); do \
	   echo "  [fw] $$d"; $(MAKE) --no-print-directory -C $$d || exit 1; \
	 done
	@echo "  [fw] los $(words $(FW407)) firmwares de la suite del F407, listos"

fw446:
	$(AVISA_VERSIONADOS)
	$(COMPRUEBA_CROSS)
	@for d in $(FW446); do \
	   echo "  [fw] $$d"; $(MAKE) --no-print-directory -C $$d || exit 1; \
	 done
	@echo "  [fw] los $(words $(FW446)) firmwares de la suite del F446, listos"

fw417:
	$(AVISA_VERSIONADOS)
	$(COMPRUEBA_CROSS)
	@for d in $(FW417); do \
	   echo "  [fw] $$d"; $(MAKE) --no-print-directory -C $$d || exit 1; \
	 done
	@echo "  [fw] el firmware de la suite del F415/F417, listo"

fwserie:
	$(AVISA_VERSIONADOS)
	$(COMPRUEBA_CROSS)
	@for d in $(FWSERIE); do \
	   echo "  [fw] $$d"; $(MAKE) --no-print-directory -C $$d || exit 1; \
	 done
	@echo "  [fw] el firmware de la suite del puente UART, listo"

fwplacas:
	$(AVISA_VERSIONADOS)
	$(COMPRUEBA_CROSS)
	@for d in $(FWPLACAS); do \
	   echo "  [fw] $$d"; $(MAKE) --no-print-directory -C $$d || exit 1; \
	 done
	@echo "  [fw] los $(words $(FWPLACAS)) firmwares de las placas de ejemplo, listos"

fwp4:
	$(AVISA_VERSIONADOS)
	$(COMPRUEBA_CROSS)
	@for d in $(FWP4); do \
	   echo "  [fw] $$d"; $(MAKE) --no-print-directory -C $$d || exit 1; \
	 done
	@echo "  [fw] los $(words $(FWP4)) firmwares de la suite del MSP432P401R, listos"

fwe4:
	$(AVISA_VERSIONADOS)
	$(COMPRUEBA_CROSS)
	@for d in $(FWE4); do \
	   echo "  [fw] $$d"; $(MAKE) --no-print-directory -C $$d || exit 1; \
	 done
	@echo "  [fw] los $(words $(FWE4)) firmwares de la suite del MSP432E401Y, listos"

fwf3:
	$(AVISA_VERSIONADOS)
	$(COMPRUEBA_CROSS)
	@for d in $(FWF3); do \
	   echo "  [fw] $$d"; $(MAKE) --no-print-directory -C $$d || exit 1; \
	 done
	@echo "  [fw] los $(words $(FWF3)) firmwares de la suite del STM32F303, listos"

# Los siete juegos, sin simular nada.
fw: fw407 fw446 fw417 fwserie fwplacas fwp4 fwe4 fwf3

# Y las suites con sus firmwares delante. En una maquina nueva ya NO hacen
# falta: `make test407` a secas funciona, porque los .bin vienen en el
# repositorio. Sirven para lo contrario, comprobar que la cadena cruzada de
# esta maquina reproduce las imagenes buenas: si las reproduce, T00 pasa y el
# tiempo simulado no se mueve; si no, T00 lo dice en la primera linea.
test407fw: fw407
	$(MAKE) --no-print-directory -f $(ESTE_MAKEFILE) test407

test446fw: fw446
	$(MAKE) --no-print-directory -f $(ESTE_MAKEFILE) test446

test417fw: fw417
	$(MAKE) --no-print-directory -f $(ESTE_MAKEFILE) test417

testseriefw: fwserie
	$(MAKE) --no-print-directory -f $(ESTE_MAKEFILE) testserie

testp4fw: fwp4
	$(MAKE) --no-print-directory -f $(ESTE_MAKEFILE) testp4
teste4fw: fwe4
	$(MAKE) --no-print-directory -f $(ESTE_MAKEFILE) teste4

testf3fw: fwf3
	$(MAKE) --no-print-directory -f $(ESTE_MAKEFILE) testf3

# Borra los .bin, .elf, .o y .map de TODOS los firmwares, sean de la suite que
# sean. Util para comprobar que la cadena cruzada funciona de cero.
#
# Lo que YA NO hace, y antes si: reproducir el estado de un arbol recien
# clonado. Un arbol recien clonado trae los .bin. Esto los BORRA, y lo que deja
# es un arbol roto en el que las tres suites fallan en su primer grupo.
cleanfw:
	@for d in $(FW_TODOS); do \
	   $(MAKE) --no-print-directory -C $$d clean >/dev/null 2>&1 || true; \
	 done
	@echo "  [fw] borrados los firmwares de $(words $(FW_TODOS)) directorios"
	@echo "  [fw] ojo: los .bin estan versionados. Para recuperarlos:"
	@echo "           git checkout -- verif/fw"

clean:
	$(BORRA)
