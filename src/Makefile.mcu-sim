# =============================================================================
# Makefile — mcu-sim, modelo SystemC de microcontroladores STM32
#
# UN SOLO FICHERO PARA LAS TRES PLATAFORMAS. La plataforma se detecta sola y se
# puede forzar con una variable, que es lo único que hay que ajustar:
#
#   make                                   Linux o macOS, nativo
#   make PLATAFORMA=windows                Windows con MinGW-w64 (MSYS2/Git Bash)
#   make PLATAFORMA=windows CXX=x86_64-w64-mingw32-g++    cruzado desde Linux
#
# Requiere SystemC >= 2.3.3 (Accellera) y un compilador con C++17. El estándar
# tiene que COINCIDIR con el que se usó al compilar la biblioteca de SystemC; si
# no, el enlazado falla con un error sobre `sc_api_version_...`. El paquete de
# Ubuntu 24.04 usa C++17; si compilas SystemC tú mismo, ajusta CXXSTD.
#
#   make SYSTEMC_HOME=/opt/systemc CXXSTD=c++14
#   make                          # el simulador: monta una placa desde un XML
#   make test407                  # la suite del F407 (2055 comprobaciones)
#   make test446                  # la del F446, que es OTRO ejecutable
#   make test417                  # la del acelerador criptografico del F415/F417
#   make hash                     # los vectores de MD5/SHA-1, sin SystemC
#   make cryp                     # los de AES/DES/TDES, tampoco
#   make red                      # la capa de red, que NO necesita SystemC
#   make vectores                 # los vectores del CRYP/HASH, sin SystemC ni compilar
#   make asan407                  # la suite del F407 con ASan + UBSan (Linux y macOS)
#   make asan446                  # y la del F446
#   make bench                    # el banco de medida del coste de simulación
#   make run IMG=firmware.bin     # carga una imagen en la Flash y simula
#   make plataforma               # qué ha detectado, sin compilar nada
#
# Las tres variables que deciden todo, por si hay que tocarlas a mano:
#
#   PLATAFORMA    linux | macos | windows
#   SYSTEMC_HOME  dónde está SystemC (include/ y la biblioteca)
#   CXX           el compilador
#   CXXSTD        el estándar de C++; TIENE que ser el mismo con el que se
#                 compiló la biblioteca de SystemC, o el enlazado falla con un
#                 `undefined reference to sc_api_version_...` (véase abajo)
#
# Y dos ganchos para añadir cosas SIN tocar este fichero, que es lo que hace
# falta cuando la biblioteca de SystemC de una máquina concreta se construyó con
# opciones distintas:
#
#   make EXTRA=-DSC_DISABLE_VIRTUAL_BIND        una macro más al compilar
#   make EXTRA_LD=-L/otra/ruta                  algo más al enlazar
#
# QUÉ HACER SI EL ENLAZADO FALLA CON `undefined reference to
# sc_core::sc_api_version_2_3_4_cxx201703L<...>`: no falta la biblioteca -si
# faltara, no habría UN símbolo sin resolver sino miles-. Es la comprobación
# deliberada que SystemC hace para que la aplicación y la biblioteca no se
# compilen con opciones distintas, y el nombre del símbolo lleva dentro la
# versión, el estándar de C++ y algunas macros. Para ver qué tiene la biblioteca
# de verdad:
#
#   nm -C $(SYSTEMC_HOME)/lib/libsystemc.a | grep api_version | head
#
# y comparar las dos cadenas. Si dice `cxx201402L`, compila con CXXSTD=c++14.
# =============================================================================

# --- 1. La plataforma --------------------------------------------------------
# En Windows, tanto cmd.exe como el `make` de MSYS2 definen la variable de
# entorno OS. Fuera de ahí se pregunta a uname. Y en los dos casos, lo que
# ponga el usuario en la línea de órdenes manda (`?=`).
ifeq ($(OS),Windows_NT)
  PLATAFORMA ?= windows
else
  ANFITRION := $(shell uname -s)
  ifeq ($(ANFITRION),Darwin)
    PLATAFORMA ?= macos
  else
    PLATAFORMA ?= linux
  endif
endif

CXXSTD ?= c++17
CXX    ?= g++

# --- 2. Lo que cambia de una plataforma a otra -------------------------------
# Son cuatro cosas y nada más: dónde suele estar SystemC, cómo se llaman sus
# directorios de biblioteca, qué bibliotecas hay que enlazar y si el ejecutable
# lleva sufijo.

ifeq ($(PLATAFORMA),windows)
  # MinGW-w64 de 64 bits, 11.2 o posterior. Con MSYS2, SystemC suele acabar en
  # /mingw64; si se compila a mano, en C:/systemc o similar.
  SYSTEMC_HOME ?= /mingw64
  EXE          := .exe
  # Los sockets son Winsock, no Berkeley (véase common/red.h).
  LIBS_SO      := -lws2_32
  # MinGW usa por omisión el printf de msvcrt, que NO entiende %llu ni %zu. El
  # modelo los usa 28 veces; sin esto, las cifras salen mal en silencio.
  DEF_SO       := -D__USE_MINGW_ANSI_STDIO=1
  # Un .exe que no necesita NINGUNA DLL de MinGW instalada: para repartirlo a
  # alumnos, esto no es un lujo.
  #
  # Y tiene que ser `-static`, no solo las dos de abajo, porque el GCC de MSYS2
  # esta construido con el modelo de hilos POSIX: `std::chrono`, `std::thread` y
  # SystemC entran por **winpthreads**, y eso mete una importacion de
  # `libwinpthread-1.dll` que `-static-libgcc -static-libstdc++` NO cubre.
  #
  # Lo que pasa si falta, medido en una maquina de verdad: el ejecutable
  # funciona desde el shell MINGW64 -ahi la DLL buena esta en el PATH- y desde
  # `cmd` da «no se encuentra el punto de entrada clock_gettime64 en la
  # biblioteca de vinculos dinamicos». Ojo al mensaje: NO dice que falte la DLL,
  # dice que la DLL que ha encontrado no exporta ese simbolo. Es decir, hay
  # OTRA `libwinpthread-1.dll` mas antigua delante en el PATH -de otro MinGW,
  # de Qt, de un IDE- y gana ella. Un fallo que depende del orden del PATH de
  # cada maquina es exactamente el que no se puede depurar por correo.
  LDEXTRA      := -static -static-libgcc -static-libstdc++
  LIBDIRS      := $(SYSTEMC_HOME)/lib $(SYSTEMC_HOME)/lib-mingw64 \
                  $(SYSTEMC_HOME)/lib64
  RPATH        :=
  BORRA        := rm -rf build
else ifeq ($(PLATAFORMA),macos)
  # Homebrew en Apple Silicon vive en /opt/homebrew; en Intel, en /usr/local.
  SYSTEMC_HOME ?= $(shell test -d /opt/homebrew/include/sysc && \
                          echo /opt/homebrew || echo /usr/local)
  EXE          :=
  LIBS_SO      := -lpthread
  DEF_SO       :=
  LDEXTRA      :=
  LIBDIRS      := $(SYSTEMC_HOME)/lib $(SYSTEMC_HOME)/lib-macosx64 \
                  $(SYSTEMC_HOME)/lib-macosarm64
  RPATH        := $(foreach d,$(LIBDIRS),-Wl,-rpath,$(d))
  BORRA        := rm -rf build
else
  SYSTEMC_HOME ?= /usr
  EXE          :=
  LIBS_SO      := -lpthread
  DEF_SO       :=
  LDEXTRA      :=
  LIBDIRS      := $(SYSTEMC_HOME)/lib $(SYSTEMC_HOME)/lib-linux64 \
                  $(SYSTEMC_HOME)/lib64 $(SYSTEMC_HOME)/lib/x86_64-linux-gnu
  RPATH        := $(foreach d,$(LIBDIRS),-Wl,-rpath,$(d))
  BORRA        := rm -rf build
endif

# --- 3. Lo que NO cambia -----------------------------------------------------
AVISOS   := -Wall -Wextra -Wno-unused-parameter
# Procesos dinamicos (sc_spawn), que pin_mux.h usa para los procesos del mux.
# `<systemc>` solo los expone si esta macro esta definida ANTES de incluirlo, asi
# que tiene que venir de aqui. Es la via oficial; la alternativa seria incluir
# una cabecera interna de SystemC, y esa es la que cambia entre versiones.
DEFS     := -DSC_INCLUDE_DYNAMIC_PROCESSES
# `-isystem` y no `-I` para SystemC: le dice al compilador que esas cabeceras no
# son nuestras y deja de avisar de lo que pasa dentro de ellas. Con GCC 16 sobre
# SystemC 2.3.4 salen decenas de avisos de -Woverloaded-virtual en los sockets de
# TLM que no podemos arreglar y que solo tapan los nuestros.
#
# CON UNA EXCEPCION, y muerde: si SystemC viene del sistema (SYSTEMC_HOME=/usr,
# que es el caso del paquete de Ubuntu), marcar /usr/include como -isystem lo
# SACA de su sitio en la cadena estandar de cabeceras y deja de encontrarse
# <stdlib.h>. Ahi hay que usar -I normal.
ifeq ($(SYSTEMC_HOME),/usr)
  INC_SYSTEMC := -I$(SYSTEMC_HOME)/include
else
  INC_SYSTEMC := -isystem $(SYSTEMC_HOME)/include
endif
CXXFLAGS += -std=$(CXXSTD) $(AVISOS) $(DEFS) $(DEF_SO) -g -O2 \
            $(INC_SYSTEMC) -I. $(EXTRA)
LDFLAGS  += $(foreach d,$(LIBDIRS),-L$(d)) $(RPATH) $(LDEXTRA)
LDLIBS   += -lsystemc $(LIBS_SO) $(EXTRA_LD)

HDRS := $(wildcard common/*.h pins/*.h parts/*.h bus/*.h mem/*.h rcc/*.h core/*.h \
                   periph/*.h soc/*.h verif/*.h top/*.h)

TEST407 := build/test407$(EXE)
MCUSIM  := build/mcu-sim$(EXE)
TEST446 := build/test446$(EXE)
TEST417 := build/test417$(EXE)
HASHV   := build/prueba_hash$(EXE)
CRYPV   := build/prueba_cryp$(EXE)
BENCH  := build/bench$(EXE)
RED    := build/prueba_red$(EXE)
ASAN407 := build/asan407$(EXE)
ASAN446 := build/asan446$(EXE)
ASAN417 := build/asan417$(EXE)

.PHONY: all test407 test446 test417 test446-build test417-build asan407 asan446 asan417 smoke bench mcu-sim red run clean plataforma vectores hash cryp

all: $(MCUSIM)

# Qué ha decidido el Makefile, por si algo no cuadra. Es la primera orden que
# hay que ejecutar cuando la compilación falla en una máquina nueva.
plataforma:
	@echo "PLATAFORMA   = $(PLATAFORMA)"
	@echo "CXX          = $(CXX)"
	@echo "CXXSTD       = $(CXXSTD)"
	@echo "SYSTEMC_HOME = $(SYSTEMC_HOME)"
	@echo "EXE          = '$(EXE)'"
	@echo "LDLIBS       = $(LDLIBS)"
	@echo "LIBDIRS      = $(LIBDIRS)"

$(TEST407): top/sc_main.cpp $(HDRS)
	@mkdir -p build
	$(CXX) $(CXXFLAGS) -o $@ top/sc_main.cpp $(LDFLAGS) $(LDLIBS)

# Banco de MEDIDA del coste de simulación (no verifica: mide)
#   make bench && ./build/bench [imagen.bin] [ms_simulados] [reset]
$(BENCH): top/bench_main.cpp $(HDRS)
	@mkdir -p build
	$(CXX) $(CXXFLAGS) -o $@ top/bench_main.cpp $(LDFLAGS) $(LDLIBS)

bench: $(BENCH)

# El modelo con la PLACA EN UN FICHERO (paso 3 de parts/)
#   make mcu-sim && ./build/mcu-sim placa.xml [firmware.bin] [ms]
$(MCUSIM): top/sim_main.cpp $(HDRS)
	@mkdir -p build
	$(CXX) $(CXXFLAGS) -o $@ top/sim_main.cpp $(LDFLAGS) $(LDLIBS)

mcu-sim: $(MCUSIM)

# La SUITE DEL F446, que es un banco APARTE y no unas pruebas mas dentro de
# `sc_main.cpp`. El motivo esta escrito en la cabecera de su fichero y merece
# saberse: construir un segundo chip dentro del banco del F407 MUEVE el
# invariante del F407, porque un chip no es inerte. Dos chips en la misma
# simulacion son una placa de dos chips.
#   make test446
$(TEST446): top/sc_main_f446.cpp $(HDRS)
	@mkdir -p build
	$(CXX) $(CXXFLAGS) -o $@ top/sc_main_f446.cpp $(LDFLAGS) $(LDLIBS)

# Construir sin ejecutar, por si se quiere compilar y lanzar a mano.
test446-build: $(TEST446)

test446: $(TEST446)
	./$(TEST446)

# --- La capa de red, que es la única parte no portable -----------------------
# No necesita SystemC, así que se compila y se ejecuta en cualquier sitio, y se
# puede CRUZAR desde Linux para comprobar que la rama de Winsock enlaza:
#
#   make red PLATAFORMA=windows CXX=x86_64-w64-mingw32-g++
#
# Es la prueba que hay que pasar antes de dar por buena una plataforma nueva.
$(RED): verif/prueba_red.cpp common/red.h
	@mkdir -p build
	$(CXX) -std=$(CXXSTD) $(AVISOS) $(DEF_SO) -O2 -I. -o $@ \
	       verif/prueba_red.cpp $(LDEXTRA) $(LIBS_SO)

# EL BANCO DEL ACELERADOR CRIPTOGRAFICO del F415/F417 (fase 2 de su plan). Es
# el TERCER ejecutable por la misma razon que el del F446 es el segundo:
# construir piezas nuevas dentro del banco del F407 mueve su invariante.
# Prueba el PROTOCOLO -DATATYPE, NBLW, DCAL, las fases del HMAC, BUSY, las dos
# interrupciones y el contexto-; la aritmetica se prueba aparte con `make hash`.
#   make test417
$(TEST417): top/sc_main_f417.cpp $(HDRS)
	@mkdir -p build
	$(CXX) $(CXXFLAGS) -o $@ top/sc_main_f417.cpp $(LDFLAGS) $(LDLIBS)

test417-build: $(TEST417)

test417: $(TEST417)
	./$(TEST417)

# Los VECTORES de MD5 y SHA-1 contra el nucleo aritmetico. NO necesita SystemC:
# `periph/hash_algo.h` es aritmetica pura, y los 23 casos con su procedencia
# estan en `verif/vectores/hash.vec` desde la fase 0.
#   make hash            # los rapidos
#   make hash V=--lentos # tambien el del millon de letras
$(HASHV): verif/prueba_hash.cpp periph/hash_algo.h
	@mkdir -p build
	$(CXX) -std=$(CXXSTD) $(AVISOS) -O2 -I. -o $@ verif/prueba_hash.cpp

hash: $(HASHV)
	./$(HASHV) $(V)

# Y los de AES, DES y TDES contra el suyo. Pasa los 16 casos de `cryp.vec` en
# las DOS direcciones: cifrar la entrada tiene que dar la salida, y descifrar la
# salida tiene que devolver la entrada.
#   make cryp
$(CRYPV): verif/prueba_cryp.cpp periph/cryp_algo.h
	@mkdir -p build
	$(CXX) -std=$(CXXSTD) $(AVISOS) -O2 -I. -o $@ verif/prueba_cryp.cpp

cryp: $(CRYPV)
	./$(CRYPV) $(V)

red: $(RED) macros-win
	./$(RED)

# EL CAMPO DE MINAS DEL PREPROCESADOR DE WINDOWS. Prueba de COMPILACION, no de
# ejecucion: define a mano las macros que Windows trae -R_OK, min, max, ERROR,
# VERSION...- e incluye las dos cabeceras que este proyecto comparte con
# mcu-sim-gui. Si alguna vuelve a usar un nombre que alli es macro, falla AQUI,
# en Linux, y no tres semanas despues en la maquina de un alumno.
#
# Va colgado de `red` a proposito: es la otra comprobacion que no necesita
# SystemC y que hay que pasar antes de dar por buena una plataforma.
.PHONY: macros-win
macros-win:
	@$(CXX) -std=$(CXXSTD) $(AVISOS) -fsyntax-only -I. \
	        verif/prueba_macros_win.cpp \
	 && echo "  [OK  ] las cabeceras compartidas sobreviven a las macros de Windows"

# Los VECTORES DE PRUEBA del acelerador criptográfico del F415/F417. No compila
# nada y no necesita SystemC: vuelve a calcular con dos implementaciones
# independientes -OpenSSL y, si está, pycryptodome- los 39 casos de
# `verif/vectores/*.vec` y los compara con lo que dice el fichero. Es la red de
# seguridad de un periférico que, mal modelado, NO falla: cifra.
#   make vectores            # los rápidos
#   make vectores V=--lentos # también el del millón de letras
vectores:
	python3 verif/vectores/comprueba_vectores.py $(V)

# La misma suite, con los sanitizers de direcciones y de comportamiento
# indefinido. Detecta lo que la suite no puede ver por sí sola: accesos fuera de
# sitio, usos después de liberar y memoria que no se devuelve.
#
#   make asan407         # compila y corre; debe salir 0 fugas y 0 avisos
#
# Va a -O1 porque con -O2 los sanitizers pierden marcos y los informes dejan de
# decir dónde. Y NO hace falta poner ASAN_OPTIONS a mano: el ejecutable trae su
# propia configuración (véase common/asan_opciones.h), sin la cual SystemC se
# rompe antes de la primera comprobación.
#
# Solo en Linux y macOS: MinGW no trae AddressSanitizer.
ASANFLAGS := -std=$(CXXSTD) $(AVISOS) $(DEFS) $(DEF_SO) -g -O1 \
             -fsanitize=address,undefined -fno-omit-frame-pointer \
             $(INC_SYSTEMC) -I. $(EXTRA)

$(ASAN407): top/sc_main.cpp $(HDRS)
	@mkdir -p build
	$(CXX) $(ASANFLAGS) -o $@ top/sc_main.cpp $(LDFLAGS) $(LDLIBS)

ifeq ($(PLATAFORMA),windows)
asan407:
	@echo "MinGW no trae AddressSanitizer: 'make asan407' solo va en Linux y macOS."
else
asan407: $(ASAN407)
	./$(ASAN407)
endif

# Lo mismo para la suite del F446. Va aparte porque es otro ejecutable, por la
# misma razón que `test446`: dos chips en una simulación son una placa de dos
# chips [top/sc_main_f446.cpp].
$(ASAN446): top/sc_main_f446.cpp $(HDRS)
	@mkdir -p build
	$(CXX) $(ASANFLAGS) -o $@ top/sc_main_f446.cpp $(LDFLAGS) $(LDLIBS)

ifeq ($(PLATAFORMA),windows)
asan446:
	@echo "MinGW no trae AddressSanitizer: 'make asan446' solo va en Linux y macOS."
else
asan446: $(ASAN446)
	./$(ASAN446)
endif

# Y para el del acelerador criptográfico, que es el tercero.
$(ASAN417): top/sc_main_f417.cpp $(HDRS)
	@mkdir -p build
	$(CXX) $(ASANFLAGS) -o $@ top/sc_main_f417.cpp $(LDFLAGS) $(LDLIBS)

ifeq ($(PLATAFORMA),windows)
asan417:
	@echo "MinGW no trae AddressSanitizer: 'make asan417' solo va en Linux y macOS."
else
asan417: $(ASAN417)
	./$(ASAN417)
endif

# Suite de verificación (autocomprobable: código de salida 0/1)
#
# Ojo: hay que ejecutarla DESDE `src/`, que es lo que hace `make`. Las imágenes
# de firmware se cargan por rutas relativas (`verif/fw/...`) y desde otro
# directorio fallan diecisiete comprobaciones que no tienen nada que ver con lo
# que se estuviera mirando.
test407: $(TEST407)
	./$(TEST407)

# Alias histórico de la fase F0
smoke: test407

run: $(TEST407)
	./$(TEST407) $(IMG)

clean:
	$(BORRA)
