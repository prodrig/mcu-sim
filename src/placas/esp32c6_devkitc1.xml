<?xml version="1.0" encoding="UTF-8"?>
<!-- ESP32-C6-DevKitC-1 (fase E9.5 de doc/analisis_esp32_riscv.md)

     El modulo ESP32-C6-WROOM-1 (N8) lleva un ESP32-C6 SIN Flash dentro, en
     QFN40, y una Flash SPI de 8 MB al lado, en SPICS0, SPICLK, SPID, SPIQ,
     SPIWP y SPIHD (GPIO24-30) [hoja de datos de ESP32-C6-WROOM-1]. Aqui, la
     pieza SpiFlash: el chip la encuentra por el nodo de SPICS0. Con
     `contenido=` guarda la Flash entre simulaciones. Lo que lleva la placa
     aparte del modulo [guia de usuario de Espressif, ESP32-C6-DevKitC-1 v1.2,
     y su esquematico]: DOS USB-C,

         UART   el puente USB-UART (CP2102N) en la UART0: su TXD a U0RXD
                (GPIO17) y su RXD a U0TXD (GPIO16). Un PuenteSerie
                (--serie UART=rfc2217:3358, memoria...), con su DTR y su RTS
                al auto-reset (Q1, AutoResetEsp):
                  esptool --port rfc2217://localhost:3358 chip-id
         USB    el USB del chip, al USB-Serial-JTAG (D- GPIO12, D+ GPIO13):
                el simulador hace de PC (usb= en el <mcu>, o --usb) y lleva
                su CDC-ACM a rfc2217:3359. ESP-IDF escribe su consola por los
                dos (la del USB es la secundaria). El JTAG de este USB: E9.6.
         BOOT   pulsador de GPIO9 a masa; RESET, de CHIP_PU a masa
         LED    el RGB (WS2812) en GPIO8: con el RMT
         J5     el puente de la corriente del modulo: aqui, siempre puesto

     El chip arranca por la ROM y lee la Flash. Una compilacion de ESP-IDF
     entra por su flash_args; un ELF bare-metal, en la HP SRAM, sin ROM:

         ./build/mcu-sim placas/esp32c6_devkitc1.xml build/idf-c6/v5.5/hello_world/flash_args --serie UART=memoria --usb memoria --ms=500
         ./build/mcu-sim placas/esp32c6_devkitc1.xml verif/fw/esp32c6/direct_boot.bin --serie UART=memoria --ms=60
-->
<placa nombre="esp32c6-devkitc-1">
  <mcu tipo="ESP32-C6" id="u0" usb="rfc2217:3359"/>

  <nodo id="CHIP_PU" bus="si"/>
  <nodo id="GPIO9" bus="si"/>
  <nodo id="DTR" externo="si"/>
  <nodo id="RTS" externo="si"/>

  <componente tipo="SpiFlash" id="U2" modelo="GD25Q64">
    <pin nombre="cs"   nodo="SPICS0"/>
    <pin nombre="clk"  nodo="SPICLK"/>
    <pin nombre="di"   nodo="SPID"/>
    <pin nombre="do"   nodo="SPIQ"/>
    <pin nombre="wp"   nodo="SPIWP"/>
    <pin nombre="hold" nodo="SPIHD"/>
  </componente>
  <componente tipo="PuenteSerie" id="UART" host="rfc2217:3358" baudios="host" formato="8N1"
              muestra="si" reinicio="esp">
    <pin nombre="rx"  nodo="GPIO16"/>   <!-- U0TXD -->
    <pin nombre="tx"  nodo="GPIO17"/>   <!-- U0RXD -->
    <pin nombre="dtr" nodo="DTR"/>
    <pin nombre="rts" nodo="RTS"/>
  </componente>
  <componente tipo="AutoResetEsp" id="Q1">
    <pin nombre="dtr" nodo="DTR"/>
    <pin nombre="rts" nodo="RTS"/>
    <pin nombre="en"  nodo="CHIP_PU"/>
    <pin nombre="io0" nodo="GPIO9"/>
  </componente>
  <componente tipo="Button" id="BOOT" v_cerrado="0" r_cerrado="10">
    <pin nombre="pin" nodo="GPIO9"/>
  </componente>
  <componente tipo="Button" id="RESET" r_cerrado="10" rebote="no">
    <pin nombre="pin" nodo="CHIP_PU"/>
  </componente>
  <componente tipo="Ws2812" id="LED" n="1">
    <pin nombre="din" nodo="GPIO8"/>
  </componente>
  <!-- GPIO8 es pin de arranque y tiene que estar alto para la descarga por
       la UART (boot:0x4); la placa lo sube con 10 kohm -->
  <componente tipo="Rpull" id="R_GPIO8" v="3.3" r="10000" visible="no">
    <pin nombre="a" nodo="GPIO8"/>
  </componente>
</placa>
