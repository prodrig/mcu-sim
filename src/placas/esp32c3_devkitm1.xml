<?xml version="1.0" encoding="UTF-8"?>
<!-- ESP32-C3-DevKitM-1 (fase E3 de doc/analisis_esp32_riscv.md, §9)

     El modulo ESP32-C3-MINI-1 lleva un ESP32-C3FN4: la Flash de 4 MB va
     dentro del chip. Lo que lleva la placa aparte del modulo [guia de usuario
     de Espressif, ESP32-C3-DevKitM-1, y su esquematico v1.0]:

         U2     el puente USB-UART (CP2102N) en la UART0: su TXD a U0RXD
                (GPIO20) y su RXD a U0TXD (GPIO21). Aqui, un PuenteSerie
                (--serie UART=rfc2217:3356, memoria...). Su DTR y su RTS van
                al auto-reset (Q1, AutoResetEsp): dos transistores a CHIP_PU
                y GPIO9 y el RC de CHIP_PU (10 kohm, 1 uF). Asi esptool,
                idf.py y Arduino la ponen en descarga solos (E5):
                  esptool --port rfc2217://localhost:3356 chip-id
         BOOT   pulsador de GPIO9 a masa
         RESET  pulsador de CHIP_PU a masa (el RC va en Q1)
         J1-J3  los cabezales: todos los GPIO del modulo
         LED    el LED RGB direccionable (WS2812) en GPIO8: la pieza Ws2812
                llega con el RMT (E8). Hasta entonces el LED de la placa NO
                se ve: blinky se ve en esp32c3_supermini.xml o en el nodo GPIO8.

     El chip arranca por la ROM y lee la Flash (E4). Una compilacion de
     ESP-IDF entra por su flash_args; un ELF bare-metal, en la SRAM, sin ROM:

         ./build/mcu-sim placas/esp32c3_devkitm1.xml build/idf/v5.5/hello_world/flash_args --serie UART=memoria --ms=500
         ./build/mcu-sim placas/esp32c3_devkitm1.xml verif/fw/esp32c3/uart.elf --serie UART=memoria --ms=10
-->
<placa nombre="esp32c3-devkitm-1">
  <mcu tipo="ESP32-C3FN4" id="u0"/>

  <nodo id="CHIP_PU" bus="si"/>
  <nodo id="GPIO9" bus="si"/>
  <nodo id="DTR" externo="si"/>
  <nodo id="RTS" externo="si"/>

  <componente tipo="PuenteSerie" id="UART" host="rfc2217:3356" baudios="host" formato="8N1"
              muestra="si" reinicio="esp">
    <pin nombre="rx"  nodo="GPIO21"/>   <!-- U0TXD -->
    <pin nombre="tx"  nodo="GPIO20"/>   <!-- U0RXD -->
    <pin nombre="dtr" nodo="DTR"/>
    <pin nombre="rts" nodo="RTS"/>
  </componente>
  <componente tipo="AutoResetEsp" id="Q1">
    <pin nombre="dtr" nodo="DTR"/>
    <pin nombre="rts" nodo="RTS"/>
    <pin nombre="en"  nodo="CHIP_PU"/>
    <pin nombre="io0" nodo="GPIO9"/>
  </componente>
  <componente tipo="Button" id="BOOT" v_cerrado="0" r_cerrado="10">
    <pin nombre="pin" nodo="GPIO9"/>
  </componente>
  <componente tipo="Button" id="RESET" r_cerrado="10" rebote="no">
    <pin nombre="pin" nodo="CHIP_PU"/>
  </componente>
  <!-- GPIO8 es pin de arranque y tiene que estar alto para la descarga por
       la UART (boot:0x4); la placa lo sube con 10 kohm -->
  <componente tipo="Rpull" id="R_GPIO8" v="3.3" r="10000" visible="no">
    <pin nombre="a" nodo="GPIO8"/>
  </componente>
</placa>
