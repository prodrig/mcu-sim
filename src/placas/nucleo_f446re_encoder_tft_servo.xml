<?xml version="1.0" encoding="UTF-8"?>
<!-- =========================================================================
     UNA NUCLEO-F446RE CON UN ENCODER DE 24 PPR, UNA PANTALLA DE PIE, UN
     SERVO Y UN ADAPTADOR FTDI

     Cuatro modulos cableados a la Nucleo, y verif/fw/encoder_tft_servo, que
     mueve el servo con el encoder, lo ensena en la pantalla y lo cuenta por
     el FTDI:

         servo      PWM    VCC    GND
         Nucleo     D5     +5V    GND
         conector   CN9.6  CN6.5  CN6.7
         chip       PB4    (USB)  VSS

         encoder    CLK    DT     SW     VCC     GND
         Nucleo     D2     D3     D4     +3V3    GND
         conector   CN9.3  CN9.4  CN9.5  CN7.16  CN7.20
         chip       PA10   PB3    PB5    VDD     VSS

         pantalla   SCK   SDA   CS    A/D   RESET  VCC    LED    GND
         Nucleo     D13   D11   D10   D9    D6     +3V3   IOREF  GND
         conector   CN5.6 CN5.4 CN5.3 CN5.2 CN9.7  CN6.4  CN6.2  CN6.6
         chip       PA5   PA7   PB6   PC7   PB10   VDD    VDD    VSS

         FTDI       RX     TX     GND
         Nucleo     morpho, arriba a la izquierda
         conector   CN7.1  CN7.2  CN7.8
         chip       PC10   PC11   VSS

     EL SERVO (placas/servo_sg90.xml) es el mini servo SG90 de 180 grados,
     azul, con el aspa de cuatro palas -dos largas y dos cortas, en cruz-.
     Va al +5V de la Nucleo, el del USB: 150 mA moviendose no los da un pin.
     Su senal es el TIM3 en PB4, un pulso cada 20 ms de 1 a 2 ms, de -90 a
     +90 grados. Al arrancar, el eje esta en un angulo cualquiera -cada vez
     uno-, y el firmware lo lleva al centro: se le ve llegar.

     EL ENCODER (placas/ky040_24ppr.xml) es un KY-040 de 24 clics y 24 pulsos
     por vuelta: un ciclo entero de CLK y DT por clic. A 3,3 V del morpho.
     Cada clic son 7,5 grados -una vuelta del mando, de -90 a +90-, a la
     derecha los positivos; apretar el eje lleva el servo al centro. En la
     ventana, la rueda del raton sobre el mando lo gira.

     LA PANTALLA (placas/tft_128x160.xml), DE PIE con el conector abajo:
     giro="90", y el firmware pone MADCTL 0x00 para verla derecha. Ensena un
     cuadrante con una aguja que apunta adonde se ha pedido, el angulo y el
     pulso. Su RESET va a D6 y no a D8 como en placas/nucleo_f446re_servo.xml:
     asi D7 y D8 -el TIM1- quedan para el encoder del segundo motor de
     placas/nucleo_f446re_encoder_lcd_servo_2xmcc.xml, que es este sistema
     ampliado.

     EL FTDI (placas/ftdi_ft232rl.xml) es la consola: la USART3 del chip,
     115200 8N1, por un cable al morpho -su RX al TX del chip, PC10; su TX al
     RX, PC11; y la masa-. Con el jumper en 3.3V, que la Nucleo es de 3,3 V;
     su VCC no se conecta: el adaptador se alimenta de su propio USB. Una
     linea con cada cambio, y escucha '+', '-' y '0': un clic a cada lado y
     el centro. Por omision, un terminal por RFC 2217 en el 3356; o en
     memoria:

         ./build/mcu-sim placas/nucleo_f446re_encoder_tft_servo.xml --ms=800 --serie F/U1=memoria

     EN LA VENTANA, cada placa en su sitio: x= e y= en cada <placa id>, en
     mm, la esquina de arriba a la izquierda de su dibujo -la Nucleo en el
     origen, el servo y el encoder a su derecha, uno encima del otro, la
     pantalla al lado y el FTDI a la izquierda, con su conector hacia el
     morpho-.

     y con la ventana, mcu-sim-gui, para verlo y mover el encoder.
     ========================================================================= -->
<sistema nombre="nucleo-f446re-encoder-tft-servo">
  <placa id="N" fichero="nucleo_f446re.xml" x="0" y="0"/>
  <placa id="S" fichero="servo_sg90.xml" x="140" y="0"/>
  <placa id="K" fichero="ky040_24ppr.xml" x="140" y="58"/>
  <placa id="T" fichero="tft_128x160.xml" giro="90" x="200" y="2"/>
  <placa id="F" fichero="ftdi_ft232rl.xml" giro="180" x="-62" y="4"/>

  <!-- El servo -->
  <hilo a="S/P1.PWM"   b="N/CN9.6"/>    <!-- D5,  PB4: TIM3_CH1 -->
  <hilo a="S/P1.VCC"   b="N/CN6.5"/>    <!-- +5V, el del USB -->
  <hilo a="S/P1.GND"   b="N/CN6.7"/>    <!-- GND -->

  <!-- El encoder -->
  <hilo a="K/P1.CLK"   b="N/CN9.3"/>    <!-- D2,  PA10 -->
  <hilo a="K/P1.DT"    b="N/CN9.4"/>    <!-- D3,  PB3 -->
  <hilo a="K/P1.SW"    b="N/CN9.5"/>    <!-- D4,  PB5 -->
  <hilo a="K/P1.VCC"   b="N/CN7.16"/>   <!-- +3V3 del morpho -->
  <hilo a="K/P1.GND"   b="N/CN7.20"/>   <!-- GND del morpho -->

  <!-- La pantalla -->
  <hilo a="T/P1.SCK"   b="N/CN5.6"/>    <!-- D13, PA5: SPI1_SCK -->
  <hilo a="T/P1.SDA"   b="N/CN5.4"/>    <!-- D11, PA7: SPI1_MOSI -->
  <hilo a="T/P1.CS"    b="N/CN5.3"/>    <!-- D10, PB6 -->
  <hilo a="T/P1.AD"    b="N/CN5.2"/>    <!-- D9,  PC7 -->
  <hilo a="T/P1.RESET" b="N/CN9.7"/>    <!-- D6,  PB10 -->
  <hilo a="T/P1.VCC"   b="N/CN6.4"/>    <!-- +3V3 -->
  <hilo a="T/P1.LED"   b="N/CN6.2"/>    <!-- IOREF, tambien 3,3 V -->
  <hilo a="T/P1.GND"   b="N/CN6.6"/>    <!-- GND -->

  <!-- El FTDI: sus nombres son los del adaptador -->
  <hilo a="F/P1.RX"    b="N/CN7.1"/>    <!-- PC10: USART3_TX -->
  <hilo a="F/P1.TX"    b="N/CN7.2"/>    <!-- PC11: USART3_RX -->
  <hilo a="F/P1.GND"   b="N/CN7.8"/>    <!-- GND -->
  <jumper ref="F/JP1" puente="VCC 3.3V"/>

  <mcu ref="N/u0" firmware="verif/fw/encoder_tft_servo/encoder_tft_servo.bin"/>
</sistema>
