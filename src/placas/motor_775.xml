<?xml version="1.0" encoding="UTF-8"?>
<!-- =========================================================================
     MOTOR 775 DE 24 V, el cabezal de una fresadora de sobremesa, sin MCU

     El motor de continua con escobillas de 42 mm que hace girar la fresa en
     la VEVOR 3018 y sus parecidas (doc/analisis_cnc.md §5.3): unas 10 000 rpm
     en vacio a 24 V, sin reductora, y en el eje la pinza de la fresa.

         M.ROJO    el + : con el mas alto, el eje gira a la DERECHA visto
         M.NEGRO   el -   desde la fresa

     EL MOTOR, MOTOR: un MotorCC (`./build/mcu-sim --help MotorCC`) con otras
     cifras. Los vendedores no publican su ficha: las 10 000 rpm y los
     0,5 A en vacio son las del anuncio; la corriente de bloqueo (40 A, la de
     un bobinado de 0,6 ohm), la de arranque, la constante de tiempo -con la
     pinza- y la inductancia (0,15 mH) son ESTIMACIONES.

     LOS MANDOS: `bloquear`, la fresa clavada, y `carga`, el par del corte,
     en % del de bloqueo.

         ./build/mcu-sim placas/motor_775.xml --valida
     ========================================================================= -->
<placa nombre="motor-775">
  <componente tipo="Conector" id="M" filas="2" columnas="1" nombres="ROJO NEGRO"/>
  <nodo id="M.ROJO" bus="si"/>
  <nodo id="M.NEGRO" bus="si"/>

  <componente tipo="MotorCC" id="MOTOR" v_nominal="24" rpm_vacio="10000" i_vacio_ma="500"
              i_bloqueo_ma="40000" i_arranque_ma="1000" tau_ms="25" l_mh="0.15"
              reduccion="1" v_max="30">
    <pin nombre="a" nodo="M.ROJO"/>
    <pin nombre="b" nodo="M.NEGRO"/>
  </componente>
</placa>
