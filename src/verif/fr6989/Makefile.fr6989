# Los programas de testfr5 (M8) para el FR6989. Los ELF se versionan en elf/:
# regenerarlos pide msp430-elf-gcc y las cabeceras de TI, en doc/refs.
#   make -f Makefile.fr6989 [MSPGCC=<bin>]
MSPGCC ?= msp430-elf-
REFS   ?= ../../../doc/refs/msp430
TI     ?= $(REFS)/ti/msp430/include_gcc
CFLAGS := -mmcu=msp430fr6989 -mlarge -I$(TI) -Ishim -L$(TI) -O1 -g -ffunction-sections -fdata-sections -Wl,--gc-sections
PROGS  := fr69_errata fr69_esi

all: $(PROGS:%=elf/%.elf)

elf/%.elf: %.c
	@mkdir -p elf
	$(MSPGCC)gcc $(CFLAGS) -o $@ $<
