# Los programas de testfr2476 (M7). Los ELF se versionan en elf/: regenerarlos pide
# msp430-elf-gcc y las cabeceras de TI, en doc/refs. Con -mlarge: el programa
# pone código, una tabla y una variable en la FRAM de arriba de 0x10000.
#   make -f Makefile.fr2476 [MSPGCC=<bin>]
MSPGCC ?= msp430-elf-
REFS   ?= ../../../doc/refs/msp430
TI     ?= $(REFS)/ti/msp430/include_gcc
CFLAGS := -mmcu=msp430fr2476 -mlarge -I$(TI) -Ishim -L$(TI) -O1 -g -ffunction-sections -fdata-sections -Wl,--gc-sections
PROGS  := fr247_basico fr247_bsl_i2c

all: $(PROGS:%=elf/%.elf)

elf/%.elf: %.c
	@mkdir -p elf
	$(MSPGCC)gcc $(CFLAGS) -o $@ $<
