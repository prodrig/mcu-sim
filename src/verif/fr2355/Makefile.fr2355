# Los programas de testfr2355 (M7). Los ELF se versionan en elf/: regenerarlos pide
# msp430-elf-gcc y las cabeceras de TI, en doc/refs.
#   make -f Makefile.fr2355 [MSPGCC=<bin>]
MSPGCC ?= msp430-elf-
REFS   ?= ../../../doc/refs/msp430
TI     ?= $(REFS)/ti/msp430/include_gcc
CFLAGS := -mmcu=msp430fr2355 -I$(TI) -Ishim -L$(TI) -O1 -g -ffunction-sections -fdata-sections -Wl,--gc-sections
PROGS  := fr235_basico

all: $(PROGS:%=elf/%.elf)

elf/%.elf: %.c
	@mkdir -p elf
	$(MSPGCC)gcc $(CFLAGS) -o $@ $<
