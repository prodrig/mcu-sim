# Los programas de testfr2311 (M7). Los ELF se versionan en elf/: regenerarlos pide
# msp430-elf-gcc, las cabeceras de TI y la DriverLib de FR2xx/FR4xx que trae el
# paquete de software de la MSP-EXP430FR2311 (BSD-3), todo en doc/refs.
#   make -f Makefile.fr2311 [MSPGCC=<bin>]
MSPGCC ?= msp430-elf-
REFS   ?= ../../../doc/refs/msp430
TI     ?= $(REFS)/ti/msp430/include_gcc
DL     ?= $(REFS)/launchpads/MSP-EXP430FR2311/sw/MSP-EXP430FR2311_Software_Examples_linux/Firmware/Source/OutOfBox_MSP430FR2311/driverlib/MSP430FR2xx_4xx
CFLAGS := -mmcu=msp430fr2311 -I$(TI) -L$(TI) -I$(DL) -Ishim -O1 -g -ffunction-sections -fdata-sections -Wl,--gc-sections
DLSRC  := cs.c eusci_a_uart.c adc.c gpio.c wdt_a.c pmm.c sac.c
PROGS  := fr23_basico

all: $(PROGS:%=elf/%.elf)

elf/%.elf: %.c
	@mkdir -p elf
	$(MSPGCC)gcc $(CFLAGS) -o $@ $< $(DLSRC:%=$(DL)/%)
