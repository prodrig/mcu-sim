# =============================================================================
# Makefile — Modelo SystemC del STM32F407VG
#
# UN SOLO FICHERO PARA LAS TRES PLATAFORMAS. La plataforma se detecta sola y se
# puede forzar con una variable, que es lo único que hay que ajustar:
#
#   make                                   Linux o macOS, nativo
#   make PLATAFORMA=windows                Windows con MinGW-w64 (MSYS2/Git Bash)
#   make PLATAFORMA=windows CXX=x86_64-w64-mingw32-g++    cruzado desde Linux
#
# Requiere SystemC >= 2.3.3 (Accellera) y un compilador con C++17. El estándar
# tiene que COINCIDIR con el que se usó al compilar la biblioteca de SystemC; si
# no, el enlazado falla con un error sobre `sc_api_version_...`. El paquete de
# Ubuntu 24.04 usa C++17; si compilas SystemC tú mismo, ajusta CXXSTD.
#
#   make SYSTEMC_HOME=/opt/systemc CXXSTD=c++14
#   make test                     # la suite de verificación (1899 comprobaciones)
#   make red                      # la capa de red, en la plataforma que sea
#   make asan                     # la suite con ASan + UBSan (Linux y macOS)
#   make sim                      # el modelo con la placa en un fichero XML
#   make bench                    # el banco de medida del coste de simulación
#   make run IMG=firmware.bin     # carga una imagen en la Flash y simula
#
# Las tres variables que deciden todo, por si hay que tocarlas a mano:
#
#   PLATAFORMA    linux | macos | windows
#   SYSTEMC_HOME  dónde está SystemC (include/ y la biblioteca)
#   CXX           el compilador
# =============================================================================

# --- 1. La plataforma --------------------------------------------------------
# En Windows, tanto cmd.exe como el `make` de MSYS2 definen la variable de
# entorno OS. Fuera de ahí se pregunta a uname. Y en los dos casos, lo que
# ponga el usuario en la línea de órdenes manda (`?=`).
ifeq ($(OS),Windows_NT)
  PLATAFORMA ?= windows
else
  ANFITRION := $(shell uname -s)
  ifeq ($(ANFITRION),Darwin)
    PLATAFORMA ?= macos
  else
    PLATAFORMA ?= linux
  endif
endif

CXXSTD ?= c++17
CXX    ?= g++

# --- 2. Lo que cambia de una plataforma a otra -------------------------------
# Son cuatro cosas y nada más: dónde suele estar SystemC, cómo se llaman sus
# directorios de biblioteca, qué bibliotecas hay que enlazar y si el ejecutable
# lleva sufijo.

ifeq ($(PLATAFORMA),windows)
  # MinGW-w64 de 64 bits, 11.2 o posterior. Con MSYS2, SystemC suele acabar en
  # /mingw64; si se compila a mano, en C:/systemc o similar.
  SYSTEMC_HOME ?= /mingw64
  EXE          := .exe
  # Los sockets son Winsock, no Berkeley (véase common/red.h).
  LIBS_SO      := -lws2_32
  # MinGW usa por omisión el printf de msvcrt, que NO entiende %llu ni %zu. El
  # modelo los usa 28 veces; sin esto, las cifras salen mal en silencio.
  DEF_SO       := -D__USE_MINGW_ANSI_STDIO=1
  # Un .exe que no necesita las DLL de MinGW instaladas: para repartirlo a
  # alumnos, esto no es un lujo.
  LDEXTRA      := -static-libgcc -static-libstdc++
  LIBDIRS      := $(SYSTEMC_HOME)/lib $(SYSTEMC_HOME)/lib-mingw64 \
                  $(SYSTEMC_HOME)/lib64
  RPATH        :=
  BORRA        := rm -rf build
else ifeq ($(PLATAFORMA),macos)
  # Homebrew en Apple Silicon vive en /opt/homebrew; en Intel, en /usr/local.
  SYSTEMC_HOME ?= $(shell test -d /opt/homebrew/include/sysc && \
                          echo /opt/homebrew || echo /usr/local)
  EXE          :=
  LIBS_SO      := -lpthread
  DEF_SO       :=
  LDEXTRA      :=
  LIBDIRS      := $(SYSTEMC_HOME)/lib $(SYSTEMC_HOME)/lib-macosx64 \
                  $(SYSTEMC_HOME)/lib-macosarm64
  RPATH        := $(foreach d,$(LIBDIRS),-Wl,-rpath,$(d))
  BORRA        := rm -rf build
else
  SYSTEMC_HOME ?= /usr
  EXE          :=
  LIBS_SO      := -lpthread
  DEF_SO       :=
  LDEXTRA      :=
  LIBDIRS      := $(SYSTEMC_HOME)/lib $(SYSTEMC_HOME)/lib-linux64 \
                  $(SYSTEMC_HOME)/lib64 $(SYSTEMC_HOME)/lib/x86_64-linux-gnu
  RPATH        := $(foreach d,$(LIBDIRS),-Wl,-rpath,$(d))
  BORRA        := rm -rf build
endif

# --- 3. Lo que NO cambia -----------------------------------------------------
AVISOS   := -Wall -Wextra -Wno-unused-parameter
CXXFLAGS += -std=$(CXXSTD) $(AVISOS) $(DEF_SO) -g -O2 \
            -I$(SYSTEMC_HOME)/include -I.
LDFLAGS  += $(foreach d,$(LIBDIRS),-L$(d)) $(RPATH) $(LDEXTRA)
LDLIBS   += -lsystemc $(LIBS_SO)

HDRS := $(wildcard common/*.h pins/*.h parts/*.h bus/*.h mem/*.h rcc/*.h core/*.h \
                   periph/*.h verif/*.h top/*.h)

TARGET := build/stm32f407vg$(EXE)
SIM    := build/sim$(EXE)
BENCH  := build/bench$(EXE)
RED    := build/prueba_red$(EXE)
ASAN   := build/tb_asan$(EXE)

.PHONY: all test asan smoke bench sim red run clean plataforma

all: $(TARGET)

# Qué ha decidido el Makefile, por si algo no cuadra. Es la primera orden que
# hay que ejecutar cuando la compilación falla en una máquina nueva.
plataforma:
	@echo "PLATAFORMA   = $(PLATAFORMA)"
	@echo "CXX          = $(CXX)"
	@echo "CXXSTD       = $(CXXSTD)"
	@echo "SYSTEMC_HOME = $(SYSTEMC_HOME)"
	@echo "EXE          = '$(EXE)'"
	@echo "LDLIBS       = $(LDLIBS)"
	@echo "LIBDIRS      = $(LIBDIRS)"

$(TARGET): top/sc_main.cpp $(HDRS)
	@mkdir -p build
	$(CXX) $(CXXFLAGS) -o $@ top/sc_main.cpp $(LDFLAGS) $(LDLIBS)

# Banco de MEDIDA del coste de simulación (no verifica: mide)
#   make bench && ./build/bench [imagen.bin] [ms_simulados] [reset]
$(BENCH): top/bench_main.cpp $(HDRS)
	@mkdir -p build
	$(CXX) $(CXXFLAGS) -o $@ top/bench_main.cpp $(LDFLAGS) $(LDLIBS)

bench: $(BENCH)

# El modelo con la PLACA EN UN FICHERO (paso 3 de parts/)
#   make sim && ./build/sim placa.xml [firmware.bin] [ms]
$(SIM): top/sim_main.cpp $(HDRS)
	@mkdir -p build
	$(CXX) $(CXXFLAGS) -o $@ top/sim_main.cpp $(LDFLAGS) $(LDLIBS)

sim: $(SIM)

# --- La capa de red, que es la única parte no portable -----------------------
# No necesita SystemC, así que se compila y se ejecuta en cualquier sitio, y se
# puede CRUZAR desde Linux para comprobar que la rama de Winsock enlaza:
#
#   make red PLATAFORMA=windows CXX=x86_64-w64-mingw32-g++
#
# Es la prueba que hay que pasar antes de dar por buena una plataforma nueva.
$(RED): verif/prueba_red.cpp common/red.h
	@mkdir -p build
	$(CXX) -std=$(CXXSTD) $(AVISOS) $(DEF_SO) -O2 -I. -o $@ \
	       verif/prueba_red.cpp $(LDEXTRA) $(LIBS_SO)

red: $(RED)
	./$(RED)

# La misma suite, con los sanitizers de direcciones y de comportamiento
# indefinido. Detecta lo que la suite no puede ver por sí sola: accesos fuera de
# sitio, usos después de liberar y memoria que no se devuelve.
#
#   make asan            # compila y corre; debe salir 0 fugas y 0 avisos
#
# Va a -O1 porque con -O2 los sanitizers pierden marcos y los informes dejan de
# decir dónde. Y NO hace falta poner ASAN_OPTIONS a mano: el ejecutable trae su
# propia configuración (véase common/asan_opciones.h), sin la cual SystemC se
# rompe antes de la primera comprobación.
#
# Solo en Linux y macOS: MinGW no trae AddressSanitizer.
ASANFLAGS := -std=$(CXXSTD) $(AVISOS) $(DEF_SO) -g -O1 \
             -fsanitize=address,undefined -fno-omit-frame-pointer \
             -I$(SYSTEMC_HOME)/include -I.

$(ASAN): top/sc_main.cpp $(HDRS)
	@mkdir -p build
	$(CXX) $(ASANFLAGS) -o $@ top/sc_main.cpp $(LDFLAGS) $(LDLIBS)

ifeq ($(PLATAFORMA),windows)
asan:
	@echo "MinGW no trae AddressSanitizer: 'make asan' solo va en Linux y macOS."
else
asan: $(ASAN)
	./$(ASAN)
endif

# Suite de verificación (autocomprobable: código de salida 0/1)
#
# Ojo: hay que ejecutarla DESDE `src/`, que es lo que hace `make`. Las imágenes
# de firmware se cargan por rutas relativas (`verif/fw/...`) y desde otro
# directorio fallan diecisiete comprobaciones que no tienen nada que ver con lo
# que se estuviera mirando.
test: $(TARGET)
	./$(TARGET)

# Alias histórico de la fase F0
smoke: test

run: $(TARGET)
	./$(TARGET) $(IMG)

clean:
	$(BORRA)
